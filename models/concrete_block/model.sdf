<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='concrete_block'>
    <!-- Model origin is at box centre.                                   -->
    <link name='link'>
      <inertial>
        <!-- 0.9 x 0.6 x 0.6 m concrete, ~2720 kg/m^3: the 880 kg the BT declares.
             Solid box: ixx = m/12 (0.6^2 + 0.6^2), iyy = izz = m/12 (0.9^2 + 0.6^2). -->
        <mass>880</mass>
        <inertia>
          <ixx>52.8</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>85.8</iyy>
          <iyz>0</iyz>
          <izz>85.8</izz>
        </inertia>
        <pose>0 0 0 0 0 0</pose>
      </inertial>
      <pose>0 0 0 0 0 0</pose>

      <visual name='visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9 0.6 0.6</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name='collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9 0.6 0.6</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>100</mu2>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <max_vel>0.1</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
