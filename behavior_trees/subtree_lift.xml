<root BTCPP_format="4">
  <!-- Lift away from the current CoG pose (grip-trajectory phase 4).
       Caller sets on the (shared) blackboard before invoking:
         lf_carries  - "true"/"false": carrying a block?
       Acts at the last CoG goal pose ({COG}). Produces: trajectory. -->
  <BehaviorTree ID="SubTreeLift">
    <Sequence name="lift">
      <!-- Loose: a lift only needs clearance, and the pendulum swings as the
           block leaves the ground, so a tight check would abort on physics. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.20"/>
      <!-- The next move need not wait out the swing: the planner starts from a measured one,
           and the tilt measurement averages it out. -->
      <SetBlackboard output_key="ex_sway_bound" value="0.1"/>
      <!-- Dwell (issue 255): a lift away from a placed block carries nothing, so the
           2.7 s period of the loaded pendulum buys it nothing. A carrying lift keeps it:
           the move after it is the carry, and the block has to be hanging still before the
           planner starts from a measured sway. -->
      <SetBlackboard output_key="ex_hold_s" value="0.3" _skipIf="lf_carries == 'true'"/>
      <SetBlackboard output_key="ex_hold_s" value="2.7" _skipIf="lf_carries != 'true'"/>
      <Script code="ex_publish_reference := true; ex_until_landed := false; ex_watch_landed := false; load_off := false"/>
      <!-- Carrying only: the 5 s default ramp is grip_traj_server_simple's
           duration_lift times slow_down, and 1.5 m of it in 5 s is 1.7 periods of the
           loaded 0.35 Hz tip mode, i.e. a near-impulse. Measured (issue 234) it
           leaves 0.20 rad peak-to-peak, 0.22 rad/s, which is 4x the gate below.
           3.0 stretches the ramp to 15 s, 5.2 periods, and cuts the arrival to
           0.073 rad / 0.092 rad/s, i.e. a factor 2.4 for a factor 3 of ramp and
           10 s a block. Not more: the residual is not all ramp shaping. The weight
           transfers to the hook the instant the block leaves the ground, and that
           step is in the plant, not in the profile, so the sway has a floor a slower
           ramp does not reach under. An empty lift keeps the caller's value: it
           decays in ~5 s and has no gate to miss.
           lf_sd_saved, not place_block's sd_saved: that one is live across its own
           descent and this subtree is called from inside the same tree.
           Multiplies the run's own slow_down rather than replacing it: the factor 3
           is this leg's shaping of the ramp, and a run already paced slower (the
           launch argument) would otherwise come back to full speed here. -->
      <Script code="lf_sd_saved := slow_down"/>
      <Script code="slow_down := lf_sd_saved * 3.0"
        _skipIf="lf_carries != 'true'"/>
      <Action ID="CalcGripMovement" name="Plan lift"
        carriesLog="{lf_carries}" logShapeText="{log_shape_text}" phase="4"
        phiToolN="{phi}" service_name="grip_traj_movement"
        server_timeout="40000" slowDown="{slow_down}"
        p_cyl_8_x="{s_log_8_x}"
        trajectory="{trajectory}" yN="{COG}"/>
      <Script code="slow_down := lf_sd_saved"/>
      <Action ID="CheckUserApproval" topic="/gpio_controller/remote_ctrl_states"/>
      <Action ID="PublishGripperState" name="Publish payload to MPC"
        carries="{lf_carries}" mass="{payload_mass}"
        log_shape_text="{log_shape_text}"
        s_log_8_x="{s_log_8_x}" s_log_8_y="{s_log_8_y}" s_log_8_z="{s_log_8_z}"/>
      <SubTree ID="SubTreeCbsA2BMovement" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>
</root>
