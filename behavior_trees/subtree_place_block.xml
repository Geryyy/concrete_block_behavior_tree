<root BTCPP_format="4">
  <!-- Place the in-hand block ({grasp_object_contains}) at place_{x,y,z,yaw},
       approaching via place_approach_{x,y}. Approach above (carrying) ->
       descend (carrying) -> write final pose to world model -> detach + open
       -> lift away empty. -->
  <BehaviorTree ID="SubTreePlaceBlock">
    <Sequence name="place_block">
      <!-- No manual correction on this path: the in-air loop starts from the plan. -->
      <Script code="seed_off_x := 0.0; seed_off_y := 0.0; place_attempt := 0"/>

      <!-- 1. Move to the pre-place approach point (above + laterally offset) -->
      <SetBlackboard output_key="mv_x" value="{place_approach_x}"/>
      <SetBlackboard output_key="mv_y" value="{place_approach_y}"/>
      <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="true"/>
      <!-- A waypoint descent that stopped short (a push, an MPC escalation) goes back up the
           collision-checked A2B move and comes down again: the grip descents are not
           collision-checked, and a 55 cm diagonal correction beside a placed block knocked
           two off the wall. -->
      <!-- A failed approach lifts straight up first: a push swung block_4 onto block_3, and
           the A2B planner refuses a start 1 cm from a block. -->
      <IfThenElse>
        <ScriptCondition code="place_vertical"/>
        <SubTree ID="SubTreePlaceSimple" _autoremap="true"/>
        <Sequence>
          <Decorator ID="RetryUntilSuccessful" num_attempts="2">
            <Fallback>
              <Sequence>
                <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
                <SubTree ID="SubTreePlaceApproach" _autoremap="true"/>
              </Sequence>
              <ForceFailure>
                <Sequence>
                  <SetBlackboard output_key="lf_carries" value="true"/>
                  <SubTree ID="SubTreeLift" _autoremap="true"/>
                </Sequence>
              </ForceFailure>
            </Fallback>
          </Decorator>
          <SubTree ID="SubTreePlaceFinish" _autoremap="true"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <!-- No neighbour (place_vertical): hover over the slot, straight down to 0.5 m over it,
       correct laterally, land on load-off. 0.5 m clears a loaded boom's bend (~0.3 m), so
       nothing here depends on the grasp offset's height; the ground ends the touchdown. -->
  <BehaviorTree ID="SubTreePlaceSimple">
    <Sequence name="place_simple">
      <Decorator ID="RetryUntilSuccessful" num_attempts="2">
        <Fallback>
          <Sequence>
            <SetBlackboard output_key="mv_x" value="{place_x}"/>
            <SetBlackboard output_key="mv_y" value="{place_y}"/>
            <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
            <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
            <SetBlackboard output_key="mv_carries" value="true"/>
            <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
            <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
            <SetBlackboard output_key="ex_sway_bound" value="0.0"/>
            <SetBlackboard output_key="ex_hold_s" value="2.7"/>
            <Script code="off_x := 0.0; off_y := 0.0; corr_done := false; place_attempt := place_attempt + 1; place_pass := 0; ex_until_landed := false"/>
            <Script code="dz_x := place_x; dz_y := place_y; dz_z := place_z + 0.50"/>
            <SetBlackboard output_key="dz_yaw" value="{place_yaw}"/>
            <SetBlackboard output_key="dz_carries" value="true"/>
            <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
            <!-- Measure, shift out a miss of 1 cm or more, up to 3 times. Repeat has no break:
                 convergence fails the body, and corr_done tells the Fallback it was that. -->
            <Fallback>
              <Repeat num_cycles="3">
                <Sequence>
                  <SubTree ID="SubTreePlaceMiss" _autoremap="true"/>
                  <Script code="corr_done := miss_x * miss_x + miss_y * miss_y &lt; 0.0001"/>
                  <ScriptCondition code="!corr_done"/>
                  <Script code="off_x := off_x + miss_x; off_y := off_y + miss_y"/>
                  <Script code="dz_x := place_x + off_x; dz_y := place_y + off_y"/>
                  <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
                </Sequence>
              </Repeat>
              <ScriptCondition code="corr_done"/>
            </Fallback>
            <!-- The third shift went down unmeasured: within 5 cm or the approach fails. -->
            <Fallback>
              <ScriptCondition code="corr_done"/>
              <Sequence>
                <SubTree ID="SubTreePlaceMiss" _autoremap="true"/>
                <ScriptCondition code="miss_x * miss_x + miss_y * miss_y &lt; 0.0025"/>
              </Sequence>
            </Fallback>
          </Sequence>
          <ForceFailure>
            <Sequence>
              <SetBlackboard output_key="lf_carries" value="true"/>
              <SubTree ID="SubTreeLift" _autoremap="true"/>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </Decorator>
      <!-- Touchdown is paced for 0.25 m; this stroke is 0.70 m (0.50 over, aimed 0.20 under). -->
      <Script code="sd_place := slow_down; slow_down := slow_down * 2.8"/>
      <SubTree ID="SubTreeTouchdown" _autoremap="true"/>
      <Script code="slow_down := sd_place"/>
    </Sequence>
  </BehaviorTree>

  <!-- Lateral miss of the carried block against place_x/y; fails on a block more than 8 cm
       under place_z + 0.50, the only height it can hit anything at. -->
  <BehaviorTree ID="SubTreePlaceMiss">
    <Sequence name="place_miss">
      <ForceSuccess>
        <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
          server_timeout="10000" mode="REFINE_GRASPED"
          target_block_id="{grasp_object_contains}" timeout_s="8.0"/>
      </ForceSuccess>
      <ForceSuccess>
        <Action ID="CaptureBlockGraspOffset"
          service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
          block_id="{grasp_object_contains}" gripper_frame="K8_tool_center_point"
          world_frame="world" grasp_offset="{grasp_offset}"
          s_log_8_x="{vision_s_log_8_x}" s_log_8_y="{vision_s_log_8_y}"
          s_log_8_z="{vision_s_log_8_z}"/>
      </ForceSuccess>
      <Action ID="MeasureBlockFromGripper" grasp_offset="{grasp_offset}" window_s="2.7"
        x="{meas_x}" y="{meas_y}" z="{meas_z}"/>
      <Script code="miss_x := place_x - meas_x; miss_y := place_y - meas_y; miss_z := place_z + 0.50 - meas_z; place_pass := place_pass + 1"/>
      <Script code="pass_verdict := !(miss_z &lt; 0.08) ? 'height' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0001 ? 'within' : 'shift')"/>
      <Action ID="PublishPlacePass" attempt="{place_attempt}" pass="{place_pass}"
        verdict="{pass_verdict}" miss_x="{miss_x}" miss_y="{miss_y}" miss_z="{miss_z}"
        off_x="{off_x}" off_y="{off_y}"/>
      <ScriptCondition code="miss_z &lt; 0.08"/>
    </Sequence>
  </BehaviorTree>

  <!-- For workflows that have already reached place_approach_* and verified
       their residual there.  This intentionally starts with the vertical
       carrying descent rather than issuing a second A2B approach motion. -->
  <BehaviorTree ID="SubTreePlaceFromHover">
    <Sequence name="place_from_hover">
      <!-- seed_off_x/seed_off_y: the caller's, the shift its own hover correction applied. -->
      <Script code="place_attempt := 0"/>
      <SubTree ID="SubTreePlaceApproach" _autoremap="true"/>
      <SubTree ID="SubTreePlaceFinish" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- From the carry hover to the waypoint over the slot, corrected in the air. Fails on a
       miss too large to correct beside placed blocks; nothing has touched down yet. -->
  <BehaviorTree ID="SubTreePlaceApproach">
    <Sequence name="place_approach">

      <!-- 1. Descend to a waypoint 30 cm over the slot and offset to its open side by the plan
           server's approach (place_approach_*: along the build direction, away from the
           placed neighbour). Straight down from the carry hover, clear of a neighbour 2 cm
           away. The correction below finishes what this leaves undone. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
      <SetBlackboard output_key="ex_sway_bound" value="0.0"/>
      <!-- The loaded dwell, in full: everything below here sets the block down, and
           issue 255 shortened it only where nothing descends onto the sway. Set here and
           not left to the move_above before, because SubTreePlaceFromHover enters without
           one and would inherit whatever the last move left. -->
      <SetBlackboard output_key="ex_hold_s" value="2.7"/>
      <!-- From the seed, not 0: a hover the operator already corrected is not undone. The miss
           below is still against the unshifted place_approach, so off stays the total. -->
      <Script code="off_x := seed_off_x; off_y := seed_off_y; still_off := true; corr_done := false; place_attempt := place_attempt + 1; place_pass := 0"/>
      <Script code="dz_x := place_approach_x + off_x; dz_y := place_approach_y + off_y"/>
      <!-- Measured K8 -> block centre at the hover, before any descent: under load the boom's
           bend made it ~0.3 m longer than the grip server's nominal 1.05 m on the crane (sim:
           1.005). No detection keeps the last refined offset, the post-lift one; no offset at
           all fails here, before anything descends. -->
      <ForceSuccess>
        <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
          server_timeout="10000" mode="REFINE_GRASPED"
          target_block_id="{grasp_object_contains}" timeout_s="8.0"/>
      </ForceSuccess>
      <Action ID="CaptureBlockGraspOffset"
        service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
        block_id="{grasp_object_contains}" gripper_frame="K8_tool_center_point"
        k8_frame="K8_tool_center_point" world_frame="world"
        grasp_offset="{grasp_offset}" s_log_8_z="{place_g}"/>
      <!-- place_g along K8's z, which hangs down. Lowers at most 10 cm: not collision-checked;
           raising is not capped. -->
      <Script code="place_dz_bias := place_g - 1.05 &lt; -0.10 ? -0.10 : place_g - 1.05"/>
      <Script code="dz_z := place_z + 0.30 + place_dz_bias"/>
      <SetBlackboard output_key="dz_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="dz_carries" value="true"/>
      <Script code="ex_until_landed := false"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>

      <!-- Correct in the air, before the angled entry: the slew and rotator stop ~5 mrad short
           of any goal, and a descent knocked by a push stopped 27 cm high and
           still passed its joint tolerance. The measured lateral miss at the waypoint
           accumulates in off_x/off_y, which shifts every later target, so a constant
           short-fall still converges.
           Lateral only (issue 256). Two reasons, both from run2_pp:
           - the waypoint's own z reaches nothing. SubTreePlaceFinish re-commands dz_z
             absolutely (place_z + 0.05 + place_dz_bias) and SubTreeTouchdown ends on
             WaitForLoadOff, so a vertically corrected waypoint changes no later target.
           - the grip server converts a commanded block centre with the nominal
             block_grip_z_offset + tcp_z_offset = 1.05 m, while MeasureBlockFromGripper reads
             the block back through the lidar-refined grasp offset (1.005 m in run2_pp, a
             45 mm gap no cycle removes). That gap is place_dz_bias, applied once at the
             hover above, so what miss_z is left with is the bend change between hover and
             waypoint. -->
      <!-- A pass that finds the block within 5 cm moves out that miss once, unmeasured, and
           leaves the Repeat instead of ticking out the remaining cycles. Repeat has no
           break, so convergence fails the body and corr_done tells the Fallback below which
           failure it was, so a too-large miss_z still propagates. -->
      <Fallback>
        <Repeat num_cycles="3">
          <Sequence>
            <!-- The block as the lidar sees it here: the column-mounted lidar is bend-free, so
                 the boom's bend at this pose enters the offset instead of the pickup's. Without
                 a detection the offset stays. -->
            <ForceSuccess>
              <Sequence>
                <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
                  server_timeout="10000" mode="REFINE_GRASPED"
                  target_block_id="{grasp_object_contains}" timeout_s="8.0"/>
                <Action ID="CaptureBlockGraspOffset"
                  service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
                  block_id="{grasp_object_contains}" gripper_frame="K8_tool_center_point"
                  world_frame="world" grasp_offset="{grasp_offset}"
                  s_log_8_x="{vision_s_log_8_x}" s_log_8_y="{vision_s_log_8_y}"
                  s_log_8_z="{vision_s_log_8_z}"/>
              </Sequence>
            </ForceSuccess>
            <!-- 2.7 s: one period of the carried pendulum. -->
            <Action ID="MeasureBlockFromGripper" grasp_offset="{grasp_offset}" window_s="2.7"
              x="{meas_x}" y="{meas_y}" z="{meas_z}"/>
            <Script code="miss_x := place_approach_x - meas_x; miss_y := place_approach_y - meas_y; miss_z := place_z + 0.30 - meas_z"/>
            <!-- Status only: the two gates below, read ahead for /cbs/status/place_pass. -->
            <Script code="place_pass := place_pass + 1; pass_verdict := !(miss_z &lt; 0.08) ? 'height' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0001 ? 'within' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0025 ? 'shift_last' : 'shift'))"/>
            <Action ID="PublishPlacePass" attempt="{place_attempt}" pass="{place_pass}"
              verdict="{pass_verdict}" miss_x="{miss_x}" miss_y="{miss_y}" miss_z="{miss_z}"
              off_x="{off_x}" off_y="{off_y}"/>
            <!-- Gross-failure gate, not a correction: a descent that stopped 28 cm short is
                 not corrected laterally. A lateral miss is corrected: steady wind holds the
                 block 14 cm aside, the same on every retry. A constant offset error cancels against
                 place_dz_bias, so this catches a descent that stopped short and a bend that
                 changed since the hover, not a wrong offset. Low only: a block left high just lands
                 later (sim JTC sagged 33 cm under load); 0.08 low fails place_approach with
                 nothing yet touched down. -->
            <ScriptCondition code="miss_z &lt; 0.08"/>
            <Script code="still_off := miss_x * miss_x + miss_y * miss_y &gt;= 0.0025"/>
            <!-- Every miss of 1 cm or more is moved out; the 5 cm gate only decides whether
                 that move is measured again. Under 1 cm, no move. corr_done only once the
                 block is where it was sent: a failed move must fail the approach. -->
            <Script code="corr_done := miss_x * miss_x + miss_y * miss_y &lt; 0.0001"/>
            <ScriptCondition code="!corr_done"/>
            <Script code="off_x := off_x + miss_x; off_y := off_y + miss_y"/>
            <!-- dz_z stays at the place_z + 0.30 + place_dz_bias set above: the corrective
                 descent re-commands the same waypoint height, it does not shift it. -->
            <Script code="dz_x := place_approach_x + off_x; dz_y := place_approach_y + off_y"/>
            <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
            <Script code="corr_done := !still_off"/>
            <ScriptCondition code="still_off"/>
          </Sequence>
        </Repeat>
        <ScriptCondition code="corr_done"/>
      </Fallback>

      <!-- The third pass ends on a descent and the Repeat then succeeds, so the last
           corrective shift went down unmeasured. Measure once more and fail the approach on a
           lateral miss still >= 5 cm, which the retry in SubTreePlaceBlock takes over;
           SubTreePlaceFromHover has no retry and ends here, as it does for miss_z in the loop.
           Skipped after an early exit (corr_done): that last move started within 5 cm.
           off_x/off_y are not shifted again, because that descent would be unmeasured in turn.
           Same two tests as a loop pass, same order, same waypoint height, so the same bands:
           miss_z the cross-check on the measure chain, lateral the acceptance. -->
      <Fallback>
        <ScriptCondition code="corr_done"/>
        <Sequence>
          <ForceSuccess>
            <Sequence>
              <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
                server_timeout="10000" mode="REFINE_GRASPED"
                target_block_id="{grasp_object_contains}" timeout_s="8.0"/>
              <Action ID="CaptureBlockGraspOffset"
                service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
                block_id="{grasp_object_contains}" gripper_frame="K8_tool_center_point"
                world_frame="world" grasp_offset="{grasp_offset}"
                s_log_8_x="{vision_s_log_8_x}" s_log_8_y="{vision_s_log_8_y}"
                s_log_8_z="{vision_s_log_8_z}"/>
            </Sequence>
          </ForceSuccess>
          <Action ID="MeasureBlockFromGripper" grasp_offset="{grasp_offset}" window_s="2.7"
            x="{meas_x}" y="{meas_y}" z="{meas_z}"/>
          <Script code="miss_x := place_approach_x - meas_x; miss_y := place_approach_y - meas_y; miss_z := place_z + 0.30 - meas_z"/>
          <Script code="place_pass := place_pass + 1; pass_verdict := !(miss_z &lt; 0.08) ? 'height' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0025 ? 'within' : 'final_fail')"/>
          <Action ID="PublishPlacePass" attempt="{place_attempt}" pass="{place_pass}"
            verdict="{pass_verdict}" miss_x="{miss_x}" miss_y="{miss_y}" miss_z="{miss_z}"
            off_x="{off_x}" off_y="{off_y}"/>
          <ScriptCondition code="miss_z &lt; 0.08"/>
          <ScriptCondition code="miss_x * miss_x + miss_y * miss_y &lt; 0.0025"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- From the corrected waypoint: angled entry, touchdown, release, lift away. -->
  <BehaviorTree ID="SubTreePlaceFinish">
    <Sequence name="place_finish">

      <!-- 2. Angled entry from the open side to 5 cm over the slot: the gap to the neighbour
           only closes to its final 2 cm. -->
      <Script code="dz_x := place_x + off_x; dz_y := place_y + off_y; dz_z := place_z + 0.05 + place_dz_bias"/>
      <!-- 0.02, not the 0.05 place_approach set (issue 241). This is the last gate before the
           block goes down and nothing re-measures it after here: the correction loop above is
           upstream, and SubTreeTouchdown only descends. 0.05 rad is 0.25 to 0.35 m at the block
           on slew, boom or arm (sensitivities in subtree_move_above.xml), against the 0.02 m
           the gap to the placed neighbour closes to. Measured: all 11 arrivals in the issue-241
           campaign that passed a 0.05 or 0.20 gate were inside 0.0100 rad on every joint, so
           0.02 keeps a factor of two and the retry re-plans rather than aborts if it misses. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.02"/>
      <!-- Retry re-plans from where it stopped, as move_above does: an MPC that escalated
           mid-move leaves the crane short and this wait times out. -->
      <Decorator ID="RetryUntilSuccessful" num_attempts="2">
        <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
      </Decorator>
      <SubTree ID="SubTreeTouchdown" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- From 5 cm over dz_x/dz_y: touchdown, release, lift away. -->
  <BehaviorTree ID="SubTreeTouchdown">
    <Sequence name="touchdown">

      <!-- 3. Final segment, straight down at half the speed, ending on landing: at full
           speed the block met the ground at 0.25 m/s and hopped.
           Aimed 20 cm under the slot: the MPC ends ~8 cm short of a descent's end, and
           10 cm low still left the hook carrying ~60 % of the landed block.
           WaitForLoadOff stops it once the hook is unloaded, and at its floor, 1 cm under
           place_z, if there is no ground. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.02"/>
      <Script code="dz_z := place_z - 0.20; ex_until_landed := true"/>
      <!-- Half the run's speed, not a fixed half: a run the launch already paced
           slower stays slower through the touchdown. -->
      <Script code="sd_saved := slow_down; slow_down := slow_down * 2.0"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
      <Script code="slow_down := sd_saved"/>

      <!-- 4. Write final block pose, then open gripper -->
      <Action ID="WriteBlockPoseFromGripper" name="Write placed pose"
        service_name="/world_model_node/upsert_block"
        server_timeout="5000"
        block_id="{grasp_object_contains}"
        world_frame="world"
        grasp_offset="{grasp_offset}"
        task_status="3"
        pose_status="2"/>
      <SetBlackboard output_key="gr_phase" value="3"/>
      <SetBlackboard output_key="gr_carries" value="true"/>
      <SubTree ID="SubTreeGripper" _autoremap="true"/>

      <!-- 3. The hook is empty again. After the jaws open, not before: until
           then the MPC is still driving a loaded crane. -->
      <Action ID="SetMpcPayload" name="Clear MPC payload"
        service_name="/crane/mpc/set_payload"
        carries="false"/>

      <!-- 4. Lift away empty -->
      <SetBlackboard output_key="lf_carries" value="false"/>
      <SubTree ID="SubTreeLift" _autoremap="true"/>

      <!-- 5. The world model keeps the lidar's pose of the placed block, not FK's, and so does
           the collision scene the planner avoids. Not the next block's target: example_wall's
           slots are absolute_position, fixed in `world`, so an error here does not compound.
           Only a relative_to_world_model slot (stack_block_1_on_block_2) builds on it. -->
      <ForceSuccess>
        <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
          server_timeout="10000" mode="REFINE_BLOCK" target_block_id="{grasp_object_contains}"
          timeout_s="8.0"/>
      </ForceSuccess>

    </Sequence>
  </BehaviorTree>
</root>
