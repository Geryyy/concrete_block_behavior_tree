<root BTCPP_format="4">
  <!-- Place the in-hand block ({grasp_object_contains}) at place_{x,y,z,yaw},
       approaching via place_approach_{x,y}. Approach above (carrying) ->
       descend (carrying) -> write final pose to world model -> detach + open
       -> lift away empty. -->
  <BehaviorTree ID="SubTreePlaceBlock">
    <Sequence name="place_block">
      <!-- No manual correction on this path: the in-air loop starts from the plan. -->
      <Script code="seed_off_x := 0.0; seed_off_y := 0.0; place_attempt := 0"/>

      <!-- 1. Move to the pre-place approach point (above + laterally offset) -->
      <SetBlackboard output_key="mv_x" value="{place_approach_x}"/>
      <SetBlackboard output_key="mv_y" value="{place_approach_y}"/>
      <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="true"/>
      <!-- A waypoint descent that stopped short (a push, an MPC escalation) goes back up the
           collision-checked A2B move and comes down again: the grip descents are not
           collision-checked, and a 55 cm diagonal correction beside a placed block knocked
           two off the wall. -->
      <!-- A failed approach lifts straight up first: a push swung block_4 onto block_3, and
           the A2B planner refuses a start 1 cm from a block. -->
      <IfThenElse>
        <ScriptCondition code="place_vertical"/>
        <SubTree ID="SubTreePlaceSimple" _autoremap="true"/>
        <Sequence>
          <Decorator ID="RetryUntilSuccessful" num_attempts="2">
            <Fallback>
              <Sequence>
                <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
                <SubTree ID="SubTreePlaceApproach" _autoremap="true"/>
              </Sequence>
              <ForceFailure>
                <Sequence>
                  <SetBlackboard output_key="lf_carries" value="true"/>
                  <SubTree ID="SubTreeLift" _autoremap="true"/>
                </Sequence>
              </ForceFailure>
            </Fallback>
          </Decorator>
          <SubTree ID="SubTreePlaceFinish" _autoremap="true"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <!-- No neighbour (place_vertical): hover over the slot, straight down to 1.1 m over it,
       correct laterally, land on load-off. 1.1 m: the loaded boom still ends ~0.3 m low at the
       waypoint (0.05 rad, lab day 11-04 and 11-09 with the pressure Psi), so the block is
       measured ~0.8 m over the slot; nothing here depends on the grasp offset's height, the
       ground ends the touchdown. -->
  <BehaviorTree ID="SubTreePlaceSimple">
    <Sequence name="place_simple">
      <Decorator ID="RetryUntilSuccessful" num_attempts="2">
        <Fallback>
          <Sequence>
            <SetBlackboard output_key="mv_x" value="{place_x}"/>
            <SetBlackboard output_key="mv_y" value="{place_y}"/>
            <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
            <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
            <SetBlackboard output_key="mv_carries" value="true"/>
            <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
            <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
            <SetBlackboard output_key="ex_sway_bound" value="0.05"/>  <!-- rad/s, MPC verdict is 0.02 -->
            <SetBlackboard output_key="ex_hold_s" value="2.7"/>
            <Script code="off_x := 0.0; off_y := 0.0; corr_done := false; place_attempt := place_attempt + 1; place_pass := 0; ex_until_landed := false; ex_watch_landed := true; load_off := false"/>
            <Script code="dz_x := place_x; dz_y := place_y; dz_z := place_z + 1.10"/>  <!-- 0.80 + 0.30 the loaded boom ends low -->
            <SetBlackboard output_key="dz_yaw" value="{place_yaw}"/>
            <SetBlackboard output_key="dz_carries" value="true"/>
            <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
            <!-- Measure, shift out a miss of 1 cm or more, up to 3 times. Repeat has no break:
                 convergence fails the body, and corr_done tells the Fallback it was that.
                 Skipped on early contact: the block is already down, and SubTreePlaceMiss
                 would read it 1.1 m under the waypoint and fail on the height. -->
            <Fallback _skipIf="load_off">
              <Repeat num_cycles="3">
                <Sequence>
                  <SubTree ID="SubTreePlaceMiss" _autoremap="true"/>
                  <Script code="corr_done := miss_x * miss_x + miss_y * miss_y &lt; 0.0001"/>
                  <ScriptCondition code="!corr_done"/>
                  <Script code="off_x := off_x + miss_x; off_y := off_y + miss_y"/>
                  <Script code="dz_x := place_x + off_x; dz_y := place_y + off_y"/>
                  <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
                  <!-- Early contact on a corrective descent leaves the loop the same way
                       convergence does: corr_done tells the Fallback it was benign. -->
                  <Script code="corr_done := true" _skipIf="!load_off"/>
                  <ScriptCondition code="!load_off"/>
                </Sequence>
              </Repeat>
              <ScriptCondition code="corr_done"/>
            </Fallback>
            <!-- The third shift went down unmeasured: within 5 cm or the approach fails. -->
            <Fallback _skipIf="load_off">
              <ScriptCondition code="corr_done"/>
              <Sequence>
                <SubTree ID="SubTreePlaceMiss" _autoremap="true"/>
                <ScriptCondition code="miss_x * miss_x + miss_y * miss_y &lt; 0.0025"/>
              </Sequence>
            </Fallback>
          </Sequence>
          <ForceFailure>
            <Sequence>
              <SetBlackboard output_key="lf_carries" value="true"/>
              <SubTree ID="SubTreeLift" _autoremap="true"/>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </Decorator>
      <IfThenElse>
        <ScriptCondition code="load_off"/>
        <SubTree ID="SubTreeEarlyContact" _autoremap="true"/>
        <Sequence>
          <!-- Touchdown is paced for 0.25 m at td_scale 2.0; this stroke is 1.3 m (1.10 over,
               aimed 0.20 under), so 5.2x that scale meets the ground at the same speed, ~52 s
               of it at slow_down 1. td_scale, not slow_down around the whole subtree: that
               also paced the release's empty lift, ~15 s of it (issue 290). -->
          <Script code="td_scale := 10.4"/>
          <SubTree ID="SubTreeTouchdown" _autoremap="true"/>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <!-- Lateral miss of the carried block against place_x/y; fails on a block less than 0.60 m
       over the slot (0.50 under place_z + 1.10). Nothing beside it on this path, and the loaded
       boom ends up to 0.05 rad (~0.3 m) low at the waypoint (lab day 11-04, 11-09). -->
  <BehaviorTree ID="SubTreePlaceMiss">
    <Sequence name="place_miss">
      <!-- No detection, no pass: on the frozen offset this measured FK against FK (303). -->
      <Script code="mi_window_s := 2.7"/>
      <SubTree ID="SubTreeMeasureInHand" _autoremap="true"/>
      <Script code="miss_x := place_x - meas_x; miss_y := place_y - meas_y; miss_z := place_z + 1.10 - meas_z; place_pass := place_pass + 1"/>
      <Script code="pass_verdict := !(miss_z &lt; 0.50) ? 'height' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0001 ? 'within' : 'shift')"/>
      <Action ID="PublishPlacePass" attempt="{place_attempt}" pass="{place_pass}"
        verdict="{pass_verdict}" miss_x="{miss_x}" miss_y="{miss_y}" miss_z="{miss_z}"
        off_x="{off_x}" off_y="{off_y}"/>
      <ScriptCondition code="miss_z &lt; 0.50"/>
    </Sequence>
  </BehaviorTree>

  <!-- For workflows that have already reached place_approach_* and verified
       their residual there.  This intentionally starts with the vertical
       carrying descent rather than issuing a second A2B approach motion. -->
  <BehaviorTree ID="SubTreePlaceFromHover">
    <Sequence name="place_from_hover">
      <!-- seed_off_x/seed_off_y: the caller's, the shift its own hover correction applied. -->
      <Script code="place_attempt := 0"/>
      <SubTree ID="SubTreePlaceApproach" _autoremap="true"/>
      <SubTree ID="SubTreePlaceFinish" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- From the carry hover to the waypoint over the slot, corrected in the air. Fails on a
       miss too large to correct beside placed blocks; nothing has touched down yet. -->
  <BehaviorTree ID="SubTreePlaceApproach">
    <Sequence name="place_approach">

      <!-- 1. Descend to a waypoint 45 cm over the slot and offset to its open side by the plan
           server's approach (place_approach_*: along the build direction, away from the
           placed neighbour). Straight down from the carry hover, clear of a neighbour 2 cm
           away. The correction below finishes what this leaves undone. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
      <SetBlackboard output_key="ex_sway_bound" value="0.05"/>  <!-- rad/s, MPC verdict is 0.02 -->
      <!-- The loaded dwell, in full: everything below here sets the block down, and
           issue 255 shortened it only where nothing descends onto the sway. Set here and
           not left to the move_above before, because SubTreePlaceFromHover enters without
           one and would inherit whatever the last move left. -->
      <SetBlackboard output_key="ex_hold_s" value="2.7"/>
      <!-- From the seed, not 0: a hover the operator already corrected is not undone. The miss
           below is still against the unshifted place_approach, so off stays the total. -->
      <Script code="off_x := seed_off_x; off_y := seed_off_y; still_off := true; corr_done := false; place_attempt := place_attempt + 1; place_pass := 0"/>
      <Script code="dz_x := place_approach_x + off_x; dz_y := place_approach_y + off_y"/>
      <!-- Nominal height. The bend used to be measured here and shifted out of every goal
           below (291), which injected the capture's own spread (9.1 cm over 90 s on one grip,
           294); the grip server corrects it from Christoph's curve instead (300). -->
      <Script code="dz_z := place_z + 0.45"/>
      <SetBlackboard output_key="dz_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="dz_carries" value="true"/>
      <Script code="ex_until_landed := false; ex_watch_landed := true; load_off := false"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>

      <!-- Correct in the air, before the angled entry: the slew and rotator stop ~5 mrad short
           of any goal, and a descent knocked by a push stopped 27 cm high and
           still passed its joint tolerance. The measured lateral miss at the waypoint
           accumulates in off_x/off_y, which shifts every later target, so a constant
           short-fall still converges.
           Lateral only (issue 256). Two reasons, both from run2_pp:
           - the waypoint's own z reaches nothing. SubTreePlaceFinish re-commands dz_z
             absolutely (place_z + 0.20) and SubTreeTouchdown ends on WaitForLoadOff, so a
             vertically corrected waypoint changes no later target.
           - the grip server converts a commanded block centre with the nominal
             block_grip_z_offset + tcp_z_offset = 1.05 m, while MeasureBlockFromGripper reads
             the block back through the lidar-refined grasp offset (1.005 m in run2_pp, a
             45 mm gap no cycle removes), plus whatever bend the grip server's own correction
             left. So miss_z is a reference mismatch, not a height to chase. -->
      <!-- A pass that finds the block within 5 cm moves out that miss once, unmeasured, and
           leaves the Repeat instead of ticking out the remaining cycles. Repeat has no
           break, so convergence fails the body and corr_done tells the Fallback below which
           failure it was, so a too-large miss_z still propagates. -->
      <!-- Skipped on early contact: the block rests 0.3 m under the waypoint, which the
           height gate below reads as a descent that stopped short. -->
      <Fallback _skipIf="load_off">
        <Repeat num_cycles="3">
          <Sequence>
            <!-- The block as the lidar sees it here: the column-mounted lidar is bend-free, so
                 the boom's bend at this pose enters the offset instead of the pickup's. No
                 detection fails the approach (303): on the frozen offset the pass measures FK
                 against FK and the bend it should cancel does not cancel (lab day 11-09). -->
            <Script code="mi_window_s := 2.7"/>
            <SubTree ID="SubTreeMeasureInHand" _autoremap="true"/>
            <Script code="miss_x := place_approach_x - meas_x; miss_y := place_approach_y - meas_y; miss_z := place_z + 0.45 - meas_z"/>
            <!-- Status only: the two gates below, read ahead for /cbs/status/place_pass. -->
            <Script code="place_pass := place_pass + 1; pass_verdict := !(miss_z &lt; 0.20) ? 'height' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0001 ? 'within' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0025 ? 'shift_last' : 'shift'))"/>
            <Action ID="PublishPlacePass" attempt="{place_attempt}" pass="{place_pass}"
              verdict="{pass_verdict}" miss_x="{miss_x}" miss_y="{miss_y}" miss_z="{miss_z}"
              off_x="{off_x}" off_y="{off_y}"/>
            <!-- Gross-failure gate, not a correction: a descent that stopped 28 cm short is
                 not corrected laterally. A lateral miss is corrected: steady wind holds the
                 block 14 cm aside, the same on every retry. A constant offset error is a
                 constant miss_z, so the band has to hold it: 0.20 covers the 72 mm reference
                 gap (lab day 11-09) plus the boom sag, which the 11-09 bags read as 0.13-0.19
                 on normal approaches - 0.15 had ~0 margin. What catches a wrong
                 offset is the load-off watch (issue 289): every descent on this path ends on
                 the ground whatever the plan thought the height was. Low only: a block left high just lands
                 later (sim JTC sagged 33 cm under load); 0.20 low still catches a 28 cm short
                 stop, with nothing yet touched down. -->
            <ScriptCondition code="miss_z &lt; 0.20"/>
            <Script code="still_off := miss_x * miss_x + miss_y * miss_y &gt;= 0.0025"/>
            <!-- Every miss of 1 cm or more is moved out; the 5 cm gate only decides whether
                 that move is measured again. Under 1 cm, no move. corr_done only once the
                 block is where it was sent: a failed move must fail the approach. -->
            <Script code="corr_done := miss_x * miss_x + miss_y * miss_y &lt; 0.0001"/>
            <ScriptCondition code="!corr_done"/>
            <Script code="off_x := off_x + miss_x; off_y := off_y + miss_y"/>
            <!-- dz_z stays at the place_z + 0.45 set above: the corrective descent
                 re-commands the same waypoint height, it does not shift it. -->
            <Script code="dz_x := place_approach_x + off_x; dz_y := place_approach_y + off_y"/>
            <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
            <!-- Early contact on a corrective descent leaves the loop the same way
                 convergence does: corr_done tells the Fallback it was benign. -->
            <Script code="corr_done := true" _skipIf="!load_off"/>
            <ScriptCondition code="!load_off"/>
            <Script code="corr_done := !still_off"/>
            <ScriptCondition code="still_off"/>
          </Sequence>
        </Repeat>
        <ScriptCondition code="corr_done"/>
      </Fallback>

      <!-- The third pass ends on a descent and the Repeat then succeeds, so the last
           corrective shift went down unmeasured. Measure once more and fail the approach on a
           lateral miss still >= 5 cm, which the retry in SubTreePlaceBlock takes over;
           SubTreePlaceFromHover has no retry and ends here, as it does for miss_z in the loop.
           Skipped after an early exit (corr_done): that last move started within 5 cm.
           off_x/off_y are not shifted again, because that descent would be unmeasured in turn.
           Same two tests as a loop pass, same order, same waypoint height, so the same bands:
           miss_z the cross-check on the measure chain, lateral the acceptance.
           Skipped on early contact, for the height reason the loop above is. -->
      <Fallback _skipIf="load_off">
        <ScriptCondition code="corr_done"/>
        <Sequence>
          <Script code="mi_window_s := 2.7"/>
          <SubTree ID="SubTreeMeasureInHand" _autoremap="true"/>
          <Script code="miss_x := place_approach_x - meas_x; miss_y := place_approach_y - meas_y; miss_z := place_z + 0.45 - meas_z"/>
          <Script code="place_pass := place_pass + 1; pass_verdict := !(miss_z &lt; 0.20) ? 'height' : (miss_x * miss_x + miss_y * miss_y &lt; 0.0025 ? 'within' : 'final_fail')"/>
          <Action ID="PublishPlacePass" attempt="{place_attempt}" pass="{place_pass}"
            verdict="{pass_verdict}" miss_x="{miss_x}" miss_y="{miss_y}" miss_z="{miss_z}"
            off_x="{off_x}" off_y="{off_y}"/>
          <ScriptCondition code="miss_z &lt; 0.20"/>
          <ScriptCondition code="miss_x * miss_x + miss_y * miss_y &lt; 0.0025"/>
        </Sequence>
      </Fallback>

    </Sequence>
  </BehaviorTree>

  <!-- From the corrected waypoint: angled entry, touchdown, release, lift away. Entered with
       load_off already true when the waypoint descent itself met the ground: then there is no
       entry left to fly and the early-contact branch decides on the spot. -->
  <BehaviorTree ID="SubTreePlaceFinish">
    <Sequence name="place_finish">

      <Sequence _skipIf="load_off">
        <!-- 2. Angled entry from the open side to 20 cm over the slot, then straight down: the
             block lands up to ~14 cm early (FK high under load), and on the slant that stops it
             short of the neighbour by tan(angle) per cm. -->
        <Script code="dz_x := place_x + off_x; dz_y := place_y + off_y; dz_z := place_z + 0.20"/>
        <Script code="ex_until_landed := false; ex_watch_landed := true; load_off := false"/>
        <!-- 0.02, not the 0.05 place_approach set (issue 241). This is the last gate before the
             block goes down and nothing corrects it after here: the correction loop above is
             upstream, and SubTreeTouchdown only descends - what it measures after landing is
             the offset the pose write needs, not a target. 0.05 rad is 0.25 to 0.35 m at the block
             on slew, boom or arm (sensitivities in subtree_move_above.xml), against the 0.02 m
             the gap to the placed neighbour closes to. Measured: all 11 arrivals in the issue-241
             campaign that passed a 0.05 or 0.20 gate were inside 0.0100 rad on every joint, so
             0.02 keeps a factor of two and the retry re-plans rather than aborts if it misses. -->
        <SetBlackboard output_key="ex_goal_tolerance" value="0.02"/>
        <!-- Retry re-plans from where it stopped, as move_above does: an MPC that escalated
             mid-move leaves the crane short and this wait times out. -->
        <Decorator ID="RetryUntilSuccessful" num_attempts="2">
          <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
        </Decorator>
      </Sequence>
      <!-- 0.40 m stroke (place_z + 0.20 to - 0.20) at 8.0 per metre, the same per-metre
           scale the simple path's 1.3 m stroke uses, so the same speed at the ground. -->
      <Script code="td_scale := 3.2"/>
      <IfThenElse>
        <ScriptCondition code="load_off"/>
        <SubTree ID="SubTreeEarlyContact" _autoremap="true"/>
        <SubTree ID="SubTreeTouchdown" _autoremap="true"/>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <!-- From 5 cm over dz_x/dz_y: touchdown, release, lift away. -->
  <BehaviorTree ID="SubTreeTouchdown">
    <Sequence name="touchdown">

      <!-- 3. Final segment, straight down at half the speed, ending on landing: at full
           speed the block met the ground at 0.25 m/s and hopped.
           Aimed 20 cm under the slot: the MPC ends ~8 cm short of a descent's end, and
           10 cm low still left the hook carrying ~60 % of the landed block.
           WaitForLoadOff stops it once the hook is unloaded, and at its floor, 0.25 m
           under place_z, if there is no ground (issue 290: 1 cm fired a cm past contact
           once the floor measured the block with the slot's own offset). -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.02"/>
      <Script code="dz_z := place_z - 0.20; ex_until_landed := true; ex_watch_landed := false; load_off := false"/>
      <!-- td_scale (2.0 per 0.25 m of stroke) times the run's speed, not a fixed half: a run
           the launch already paced slower stays slower through the touchdown, and a longer
           stroke keeps the same speed at the ground. Around the descent only: the release
           below, and the empty lift in it, run at the run's own pace. Set in every caller,
           the blackboard is shared. -->
      <Script code="sd_saved := slow_down; slow_down := slow_down * td_scale"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
      <Script code="slow_down := sd_saved"/>
      <!-- No re-measure on the landed block (332). It only fed the COARSE write below, which
           the post-release REFINE_BLOCK overwrites, while its own failure left the block
           landed, the jaws shut and the block TASK_MOVE. So the write uses the in-air offset:
           the hook is pinned on landing, and the misplaced gate in the release is what reads
           the difference. -->
      <SubTree ID="SubTreeRelease" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- The block is down: write its pose, open the jaws, lift away empty. The tail of the
       touchdown, also entered on early contact, where no touchdown ran. -->
  <BehaviorTree ID="SubTreeRelease">
    <Sequence name="release">

      <!-- 4. Write final block pose, then open gripper. The offset is the last one measured in
           the air (332): the early-contact caller re-measures on the ground, the touchdown
           does not.
           Before the open: once the jaws let go the gripper swings, and FK x the offset wrote
           poses 0.1-0.4 m off (327 sim). pose_status and confidence are the plugin's defaults,
           COARSE and under 1: this is FK x the offset, and the REFINE_BLOCK at the end of the
           subtree is what measures it (303 - block_0's FK pose went in as PRECISE conf 1.0 and
           became task 2's target). -->
      <Action ID="WriteBlockPoseFromGripper" name="Write placed pose"
        service_name="/world_model_node/upsert_block"
        server_timeout="5000"
        block_id="{grasp_object_contains}"
        world_frame="world"
        grasp_offset="{grasp_offset}"
        task_status="3"
        x="{written_x}" y="{written_y}" z="{written_z}"/>
      <SetBlackboard output_key="gr_phase" value="3"/>
      <SetBlackboard output_key="gr_carries" value="true"/>
      <SubTree ID="SubTreeGripper" _autoremap="true"/>
      <!-- A jaw goal that ends SUCCESS is no open: a cancelled one reads so too. Not open (shut
           = lost on the way) puts the block back to TASK_MOVE, so a restart resumes it instead of
           picking the next one with it in the jaws, and the MPC stays loaded (327). -->
      <Fallback name="jaws_opened_or_back_in_hand">
        <Action ID="WaitForGraspSignal" name="Jaws did not open on the placed block - check the hook"
          topic="/gripper/jaws_open" timeout_ms="5000"/>
        <Sequence>
          <Action ID="SetBlockTaskStatus" name="Mark block TASK_MOVE again"
            service_name="/world_model_node/set_block_task_status" server_timeout="5000"
            block_id="{grasp_object_contains}" task_status="2" grasp_offset="{grasp_offset}"/>
          <AlwaysFailure/>
        </Sequence>
      </Fallback>

      <!-- 3. The hook is empty again. After the jaws open, not before: until
           then the MPC is still driving a loaded crane. -->
      <Action ID="SetMpcPayload" name="Clear MPC payload"
        service_name="/crane/mpc/set_payload"
        carries="false"/>

      <!-- 4. Lift away empty -->
      <SetBlackboard output_key="lf_carries" value="false"/>
      <SubTree ID="SubTreeLift" _autoremap="true"/>

      <!-- 5. The world model keeps the lidar's pose of the placed block, not FK's, and so does
           the collision scene the planner avoids. Not the next block's target: example_wall's
           slots are absolute_position, fixed in `world`, so an error here does not compound.
           Only a relative_to_world_model slot (stack_block_1_on_block_2) builds on it.
           Mandatory since 303: the write above is COARSE, so without this pass nothing ever
           measured the placed block. -->
      <SubTree ID="SubTreeRefineBlock" _autoremap="true"/>
      <!-- How far the lidar had to move the block from where the hook let it go. Over 0.10 m
           the block is not on its slot: in every oracle example_wall run with noise seed 0 the
           descent stalled with the hook still carrying ~17-19 cm over the slot, the touchdown
           took that for a landing (its WaitForLoadOff accepts 0.20 m, port default), the jaws
           opened and block_2 fell ~0.2 m - laterally 5-14 cm out, and TASK_PLACED (332).
           Two one-sided tests, not the correction's norm: laterally it is symmetric, but in z
           only *below* the written pose counts, because the lidar reads a ground block
           0.12-0.25 m too high (readiness A3) while a block let go in the air was written
           that much too high - so on the machine the bias blunts the z arm, and it is the
           sim's bias-free oracle it catches the drop in. -->
      <ScriptCondition name="Block misplaced - the lidar moved it over 0.10 m from the release"
        code="(refine_x - written_x) * (refine_x - written_x) + (refine_y - written_y) * (refine_y - written_y) &lt; 0.01 &amp;&amp; refine_z - written_z &gt; -0.10"/>

    </Sequence>
  </BehaviorTree>

  <!-- The load came off before the descent's target (WaitForLoadOff logs "early contact" and
       the height): the block rests on something the plan put lower than it is. Nothing
       descends again from here, and the height only has to tell the slot's own ground from a
       neighbour's top (332) - within that it decides nothing, the ground being the better
       reference for z than the plan, which is what the simple path already leans on. On the
       slot, let go; otherwise lift clear and fail the place, so the block does not stay
       where the next one is planned. -->
  <BehaviorTree ID="SubTreeEarlyContact">
    <Sequence name="early_contact">
      <!-- Where it came to rest: the lidar first, the block may have slid in the jaws as the
           hook unloaded. No detection fails the place (303): the band below and the pose write
           both read this offset.
           0.5 s, not the loaded 2.7: the block is down, there is no pendulum to average out. -->
      <Script code="mi_window_s := 0.5"/>
      <SubTree ID="SubTreeMeasureInHand" _autoremap="true"/>
      <Script code="miss_x := place_x - meas_x; miss_y := place_y - meas_y; miss_z := place_z - meas_z"/>
      <!-- IfThenElse, not a Fallback: a Fallback would also take the lift branch when the
           release itself failed late, and that lift runs with lf_carries true, i.e. 880 kg
           of feedforward onto a hook whose jaws are already open. The band decides which
           branch runs; a failure inside the chosen branch fails the place. -->
      <IfThenElse>
        <!-- The place's own lateral band, the one its last in-air pass accepts, and the slot's
             own height (332): load-off alone is also satisfied by a block resting on a
             neighbour, on the hedge or in an occupied slot, which is where the jaws must not
             open (readiness S1). 0.30 m covers the lidar's one-sided z bias on a ground
             block (it reads 0.12-0.25 m too high, readiness A3), which eats the band on one
             side; a neighbour or the hedge is ~0.6 m up. The trigger
             is unchanged - this decides the release, not the contact. -->
        <ScriptCondition code="miss_x * miss_x + miss_y * miss_y &lt; 0.0025 &amp;&amp; miss_z * miss_z &lt; 0.09"/>
        <SubTree ID="SubTreeRelease" _autoremap="true"/>
        <Decorator ID="ForceFailure">
          <Sequence name="The block came down off its slot - lifted clear, jaws still shut">
            <SetBlackboard output_key="lf_carries" value="true"/>
            <SubTree ID="SubTreeLift" _autoremap="true"/>
          </Sequence>
        </Decorator>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>
</root>
