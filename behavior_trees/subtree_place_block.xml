<root BTCPP_format="4">
  <!-- Place the in-hand block ({grasp_object_contains}) at place_{x,y,z,yaw},
       approaching via place_approach_{x,y}. Approach above (carrying) ->
       descend (carrying) -> write final pose to world model -> detach + open
       -> lift away empty. -->
  <BehaviorTree ID="SubTreePlaceBlock">
    <Sequence name="place_block">

      <!-- 1. Move to the pre-place approach point (above + laterally offset) -->
      <SetBlackboard output_key="mv_x" value="{place_approach_x}"/>
      <SetBlackboard output_key="mv_y" value="{place_approach_y}"/>
      <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="true"/>
      <!-- A waypoint descent that stopped short (a push, an MPC escalation) goes back up the
           collision-checked A2B move and comes down again: the grip descents are not
           collision-checked, and a 55 cm diagonal correction beside a placed block knocked
           two off the wall. -->
      <!-- A failed approach lifts straight up first: a push swung block_4 onto block_3, and
           the A2B planner refuses a start 1 cm from a block. -->
      <Decorator ID="RetryUntilSuccessful" num_attempts="2">
        <Fallback>
          <Sequence>
            <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
            <SubTree ID="SubTreePlaceApproach" _autoremap="true"/>
          </Sequence>
          <ForceFailure>
            <Sequence>
              <SetBlackboard output_key="lf_carries" value="true"/>
              <SubTree ID="SubTreeLift" _autoremap="true"/>
            </Sequence>
          </ForceFailure>
        </Fallback>
      </Decorator>
      <SubTree ID="SubTreePlaceFinish" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- For workflows that have already reached place_approach_* and verified
       their residual there.  This intentionally starts with the vertical
       carrying descent rather than issuing a second A2B approach motion. -->
  <BehaviorTree ID="SubTreePlaceFromHover">
    <Sequence name="place_from_hover">
      <SubTree ID="SubTreePlaceApproach" _autoremap="true"/>
      <SubTree ID="SubTreePlaceFinish" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- From the carry hover to the waypoint over the slot, corrected in the air. Fails on a
       miss too large to correct beside placed blocks; nothing has touched down yet. -->
  <BehaviorTree ID="SubTreePlaceApproach">
    <Sequence name="place_approach">

      <!-- 1. Descend to a waypoint 30 cm over the slot and offset to its open side by the plan
           server's approach (place_approach_*: along the build direction, away from the
           placed neighbour). Straight down from the carry hover, clear of a neighbour 2 cm
           away. The correction below finishes what this leaves undone. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
      <SetBlackboard output_key="ex_sway_bound" value="0.0"/>
      <SetBlackboard output_key="dz_x" value="{place_approach_x}"/>
      <SetBlackboard output_key="dz_y" value="{place_approach_y}"/>
      <Script code="dz_z := place_z + 0.30"/>
      <SetBlackboard output_key="dz_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="dz_carries" value="true"/>
      <Script code="ex_until_landed := false"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>

      <!-- Correct in the air, before the angled entry: the slew and rotator stop ~5 mrad short
           of any goal, and a descent knocked by a push stopped 27 cm high and
           still passed its joint tolerance. The measured 3-D miss at the waypoint
           accumulates in off_*, which shifts every later target, so a constant short-fall
           still converges. Under 1 cm, no move. -->
      <Script code="off_x := 0.0; off_y := 0.0; off_z := 0.0"/>
      <Repeat num_cycles="3">
        <Sequence>
          <!-- 2.7 s: one period of the carried pendulum. -->
          <Action ID="MeasureBlockFromGripper" grasp_offset="{grasp_offset}" window_s="2.7"
            x="{meas_x}" y="{meas_y}" z="{meas_z}"/>
          <Script code="miss_x := place_approach_x - meas_x; miss_y := place_approach_y - meas_y; miss_z := place_z + 0.30 - meas_z"/>
          <!-- Vertical only: a descent that stopped 28 cm short is not corrected diagonally
               A lateral miss is: steady wind holds the block 14 cm aside, the same on every
               retry. -->
          <ScriptCondition code="miss_z * miss_z &lt; 0.0064"/>
          <Sequence _skipIf="miss_x * miss_x + miss_y * miss_y + miss_z * miss_z &lt; 0.0001">
            <Script code="off_x := off_x + miss_x; off_y := off_y + miss_y; off_z := off_z + miss_z"/>
            <Script code="dz_x := place_approach_x + off_x; dz_y := place_approach_y + off_y; dz_z := place_z + 0.30 + off_z"/>
            <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
          </Sequence>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- From the corrected waypoint: angled entry, touchdown, release, lift away. -->
  <BehaviorTree ID="SubTreePlaceFinish">
    <Sequence name="place_finish">

      <!-- 2. Angled entry from the open side to 5 cm over the slot: the gap to the neighbour
           only closes to its final 2 cm. -->
      <Script code="dz_x := place_x + off_x; dz_y := place_y + off_y; dz_z := place_z + 0.05"/>
      <!-- Retry re-plans from where it stopped, as move_above does: an MPC that escalated
           mid-move leaves the crane short and this wait times out. -->
      <Decorator ID="RetryUntilSuccessful" num_attempts="2">
        <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
      </Decorator>
      <SubTree ID="SubTreeTouchdown" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- From 5 cm over dz_x/dz_y: touchdown, release, lift away. -->
  <BehaviorTree ID="SubTreeTouchdown">
    <Sequence name="touchdown">

      <!-- 3. Final segment, straight down at half the speed, ending on landing: at full
           speed the block met the ground at 0.25 m/s and hopped.
           Aimed 20 cm under the slot: the MPC ends ~8 cm short of a descent's end, and
           10 cm low still left the hook carrying ~60 % of the landed block.
           WaitForLoadOff stops it once the hook is unloaded, and at its floor, 1 cm under
           place_z, if there is no ground. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.02"/>
      <Script code="dz_z := place_z - 0.20; ex_until_landed := true"/>
      <SetBlackboard output_key="sd_saved" value="{slow_down}"/>
      <SetBlackboard output_key="slow_down" value="2.0"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
      <SetBlackboard output_key="slow_down" value="{sd_saved}"/>

      <!-- 4. Write final block pose, then open gripper -->
      <Action ID="WriteBlockPoseFromGripper" name="Write placed pose"
        service_name="/world_model_node/upsert_block"
        server_timeout="5000"
        block_id="{grasp_object_contains}"
        world_frame="world"
        grasp_offset="{grasp_offset}"
        task_status="3"
        pose_status="2"/>
      <SetBlackboard output_key="gr_phase" value="3"/>
      <SetBlackboard output_key="gr_carries" value="true"/>
      <SubTree ID="SubTreeGripper" _autoremap="true"/>

      <!-- 3. The hook is empty again. After the jaws open, not before: until
           then the MPC is still driving a loaded crane. -->
      <Action ID="SetMpcPayload" name="Clear MPC payload"
        service_name="/crane/mpc/set_payload"
        carries="false"/>

      <!-- 4. Lift away empty -->
      <SetBlackboard output_key="lf_carries" value="false"/>
      <SubTree ID="SubTreeLift" _autoremap="true"/>

    </Sequence>
  </BehaviorTree>
</root>
