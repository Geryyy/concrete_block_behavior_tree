<?xml version="1.0"?>
<root main_tree_to_execute="StackC0B0OnC0B1">
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_execute_trajectory.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_move_above.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_descend_to.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_gripper.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_lift.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_pick_block.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_place_block.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_pick_and_place_block.xml"/>

  <BehaviorTree ID="StackC0B0OnC0B1">
    <Sequence name="stack_c0_b0_on_c0_b1">

      <!-- Shared skill parameters -->
      <SetBlackboard output_key="slow_down" value="1.0"/>
      <SetBlackboard output_key="s_log_8_x" value="0.0"/>
      <!-- Block approximated as cylinder for timber planner compatibility -->
      <SetBlackboard output_key="logShape"
        value="{radius_top: 0.30, radius_bottom: 0.30, length: 0.90}"/>
      <!-- CBS has no log-scene perception. logsScene is left unset on the
           blackboard so CalcA2BMovement's getInput returns failure without
           attempting convertFromString<vector<Log>>; request_->logs_scene
           stays empty. -->

      <GetNextAssemblyTask
        service_name="/concrete_block_wall_plan_server/get_next_assembly_task"
        server_timeout="10000"
        wall_plan_name="stack_block_1_on_block_2"
        reset_plan="true"
        task_id="{task_id}"
        target_block_id="{target_block_id}"
        reference_block_id="{reference_block_id}"
        target_block_pose_coarse="{target_block_pose_coarse}"
        target_block_pose_precise="{target_block_pose_precise}"
        reference_block_pose_precise="{reference_block_pose_precise}"
        plan_has_task="{plan_has_task}"
        plan_message="{plan_message}"
        pickup_x="{pickup_x}"
        pickup_y="{pickup_y}"
        pickup_z="{pickup_z}"
        pickup_yaw="{pickup_yaw}"
        place_x="{place_x}"
        place_y="{place_y}"
        place_z="{place_z}"
        place_yaw="{place_yaw}"
        pickup_approach_z="{approach_z}"
        approach_x="{place_approach_x}"
        approach_y="{place_approach_y}"
        approach_z="{place_approach_z}"/>

      <SetBlackboard output_key="grasp_object_contains" value="{target_block_id}"/>

      <SubTree ID="SubTreePickAndPlaceBlock" __shared_blackboard="true"/>

    </Sequence>
  </BehaviorTree>
</root>
