<?xml version="1.0"?>
<root main_tree_to_execute="BasicPickAndPlace">
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_execute_trajectory.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_move_above.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_descend_to.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_gripper.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_lift.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_pick_block.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_place_block.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_pick_and_place_block.xml"/>
  <!-- ////////// -->
  <BehaviorTree ID="BasicPickAndPlace">
    <Sequence>
      <SetBlackboard output_key="slow_down" value="1.0"/>
      <SetBlackboard output_key="s_log_8_x" value="0.0"/>
      <SetBlackboard output_key="s_log_8_y" value="0.0"/>
      <SetBlackboard output_key="s_log_8_z" value="nan"/>
      <SetBlackboard output_key="payload_mass" value="777.6"/>
      <SetBlackboard output_key="approach_z" value="2.0"/>
      <SetBlackboard output_key="carry_approach_z" value="2.0"/>
      <SetBlackboard output_key="grasp_object_contains" value="block_0"/>
      <SetBlackboard output_key="pickup_x" value="6.06"/>
      <SetBlackboard output_key="pickup_y" value="0.35"/>
      <SetBlackboard output_key="pickup_z" value="-0.84"/>
      <SetBlackboard output_key="pickup_yaw" value="-1.5708"/>
      <SetBlackboard output_key="place_x" value="5.0"/>
      <SetBlackboard output_key="place_y" value="-2.0"/>
      <SetBlackboard output_key="place_z" value="-0.84"/>
      <SetBlackboard output_key="place_yaw" value="-1.5708"/>
      <SetBlackboard output_key="place_approach_x" value="5.0"/>
      <SetBlackboard output_key="place_approach_y" value="-2.0"/>
      <SetBlackboard output_key="place_approach_z" value="{carry_approach_z}"/>
      <SetBlackboard output_key="log_shape_text"
        value="radius_top: 0.30, radius_bottom: 0.30, length: 0.90"/>
      <!-- CBS has no log-scene perception; leave logsScene unset on the BB.
           CalcA2BMovement's getInput returns failure without convertFromString
           and request_->logs_scene stays default-empty. -->

      <SubTree ID="SubTreePickAndPlaceBlock" __shared_blackboard="true"/>
    </Sequence>
  </BehaviorTree>
  <!-- ////////// -->
</root>
