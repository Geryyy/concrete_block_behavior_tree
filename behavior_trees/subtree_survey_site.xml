<?xml version="1.0"?>
<root BTCPP_format="4">
  <!-- Scan the site before the first pick (issue 323). The binding can only choose among the
       blocks it knows, and the reactive discovery in the assembly loop finds them one at a
       time, so every configured survey pose is visited up front: empty A2B move there, then
       SCENE_DISCOVERY. Poses per site in config/survey_sites.yaml, picked by `survey_site`;
       without one IterateSurveyPoses never ticks the child.
       Caller sets what SubTreeMoveAbove needs apart from mv_*: log_shape_text, payload_mass,
       s_log_8_*, slow_down. -->
  <BehaviorTree ID="SubTreeSurveySite">
    <!-- The survey plans every move as an empty hook. A goal restarted between grip and place
         has a block in the jaws (SubTreeResumeCarry, inside the assembly loop and downstream of
         here), and surveying with it would plan without its collision body and tell the MPC the
         hook is empty: skip the survey instead and let the resume branch take it. The gate is
         the jaws' own empty signal, as every other empty-hook move's is (327). -->
    <IfThenElse>
      <Action ID="WaitForGraspSignal" name="Nothing in the jaws - the site can be surveyed"
        topic="/gripper/jaws_empty" timeout_ms="2000"/>
      <!-- No ForceSuccess around the discovery: finding nothing at a pose is `blocks` not
           growing, which the decorator weighs over all poses; a failure here is the service or
           the detector, and that ends the goal with its own message (303). -->
      <IterateSurveyPoses name="survey_each_pose" blocks="{survey_blocks}"
        survey_x="{mv_x}" survey_y="{mv_y}" survey_z="{mv_z}" survey_yaw="{mv_yaw}">
        <Sequence name="look_from_one_pose">
          <Script code="mv_carries := 'false'"/>
          <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
          <RunPoseEstimation
            service_name="/world_model_node/run_pose_estimation" server_timeout="10000"
            mode="SCENE_DISCOVERY" timeout_s="10.0" block_count="{survey_blocks}"/>
        </Sequence>
      </IterateSurveyPoses>
      <AlwaysSuccess name="Something in the jaws - no survey, the resume branch has it"/>
    </IfThenElse>
  </BehaviorTree>
</root>
