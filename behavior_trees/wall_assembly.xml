<?xml version="1.0"?>
<root main_tree_to_execute="WallAssembly" BTCPP_format="4">
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_execute_trajectory.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/cbs_subtree_a2b_movement.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_move_above.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_descend_to.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_gripper.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_lift.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_pick_block.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_place_block.xml"/>
  <include ros_pkg="concrete_block_behavior_tree" path="behavior_trees/subtree_pick_and_place_block.xml"/>
  <!-- ////////// -->
  <BehaviorTree ID="WallAssembly">
    <Sequence>

      <!-- ============================================================
           CONFIGURATION
           ============================================================ -->
      <!-- The run's pace, from the BT server's `slow_down` parameter (launch argument of
           the same name, 1.0 = full speed). A Script/output port, not SetBlackboard: the
           legs that want to be slower multiply this entry, and SetBlackboard would create
           it as a string. -->
      <GetSlowDown slow_down="{slow_down}"/>
      <SetBlackboard output_key="s_log_8_x" value="0.0"/>
      <SetBlackboard output_key="s_log_8_y" value="0.0"/>
      <SetBlackboard output_key="s_log_8_z" value="nan"/>
      <SetBlackboard output_key="payload_mass" value="880.0"/>
      <Script code="plan_has_task := true; survey_x := 0.0; survey_y := 0.0; survey_z := 0.0; survey_yaw := 0.0"/>
      <!-- Where a crooked grip is set down and taken again (SubTreeRegrip), K0_mounting_base:
           world (-13, 1.5), level and clear of example_wall's pickups. z is a block resting
           on the ground: world 0.3 against K0 at world z 1.1407. Needed explicitly because
           the pickup is not always ground level: off the truck bed it is world 1.62. -->
      <Script code="regrip_x := 6.06; regrip_y := -1.15; regrip_z := -0.8407"/>
      <!-- Pickup approach and place approach come from the wall plan server.
           Place approach is a high A2B endpoint; CalcGripMovement handles the
           low angled final descent. -->
      <!-- Block approximated as cylinder for timber planner compatibility -->
      <!-- Planner collision body for the carried block (only the planner reads the shape): a
           vertical cylinder around the upright 0.9 x 0.6 x 0.6 m block, radius its footprint's
           half-diagonal sqrt(0.45^2 + 0.3^2). The old r 0.30 / l 0.90 missed the corners. -->
      <SetBlackboard output_key="log_shape_text" value="radius_top: 0.541, radius_bottom: 0.541, length: 0.60"/>
      <!-- CBS has no log-scene perception; leave logsScene unset on the BB.
           CalcA2BMovement's getInput returns failure without convertFromString
           and request_->logs_scene stays default-empty. -->

      <!-- ============================================================
           ASSEMBLY LOOP
           The loop runs until its child fails. That failure has two causes:
           (a) the plan is complete (GetNextAssemblyTask returns has_task=false),
           or (b) a genuine pick/place failure. The Fallback's recovery branch
           uses PlanComplete to turn (a) into overall SUCCESS while letting (b)
           propagate as FAILURE. GetNextAssemblyTask writes plan_has_task to the
           blackboard before returning, so the two causes are distinguishable.
           ============================================================ -->
      <Fallback name="assembly_until_complete">
        <KeepRunningUntilFailure name="assembly_loop">
          <Sequence name="pick_and_place_one_block">

            <!-- wall_plan_name="" deliberately: this must consume exactly the
               plan the operator activated in the Plan Control RViz panel,
               not a hidden default baked into this tree (see
               wall_plan_server.py's _handle_get_next_task); matches
               operator_guided_single_block.xml's existing pattern. Activate
               a plan (e.g. "example_wall") in Plan Control before running
               this tree. -->
            <!-- A slot whose block is not known yet (hidden behind another from the lidar on
                 the slewing column, or never seeded) leaves the server waiting: discover from
                 here and ask again. A finished plan skips the discovery. -->
            <RetryUntilSuccessful num_attempts="3">
              <Fallback>
                <GetNextAssemblyTask
                  service_name="/concrete_block_wall_plan_server/get_next_assembly_task"
                  server_timeout="10000"
                  wall_plan_name=""
                  reset_plan="false"
                  task_id="{task_id}"
                  target_block_id="{target_block_id}"
                  reference_block_id="{reference_block_id}"
                  target_block_pose_coarse="{target_block_pose_coarse}"
                  target_block_pose_precise="{target_block_pose_precise}"
                  reference_block_pose_precise="{reference_block_pose_precise}"
                  plan_has_task="{plan_has_task}"
                  plan_message="{plan_message}"
                  pickup_x="{pickup_x}"
                  pickup_y="{pickup_y}"
                  pickup_z="{pickup_z}"
                  pickup_yaw="{pickup_yaw}"
                  place_x="{place_x}"
                  place_y="{place_y}"
                  place_z="{place_z}"
                  place_yaw="{place_yaw}"
                  pickup_approach_z="{approach_z}"
                  approach_x="{place_approach_x}"
                  approach_y="{place_approach_y}"
                  approach_z="{place_approach_z}"/>
                <Sequence>
                  <ScriptCondition code="plan_has_task"/>
                  <!-- Back over the last pickup first: from the wall the column-mounted lidar
                       looks away, and at the lift the lifted block still hid the next one. The
                       plan's survey_position comes back as pickup_* (off the line of sight, so
                       the hook does not shadow the far blocks); without one the answer is
                       zeroes and the last pickup hover, saved below, stands in. The yaw is
                       always the last pickup's: the offered 0 wound the rotator a full turn
                       (4.76 rad) on the way to the next pickup, and the loaded lift's MPC QP was
                       infeasible from its first tick. -->
                  <ForceSuccess>
                    <Sequence>
                      <Script code="offered := pickup_x != 0.0 || pickup_y != 0.0; mv_x := offered ? pickup_x : survey_x; mv_y := offered ? pickup_y : survey_y; mv_z := offered ? approach_z : survey_z; mv_yaw := survey_yaw; mv_carries := 'false'"/>
                      <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
                    </Sequence>
                  </ForceSuccess>
                  <ForceSuccess>
                    <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
                      server_timeout="10000" mode="SCENE_DISCOVERY" timeout_s="10.0"/>
                  </ForceSuccess>
                  <AlwaysFailure/>
                </Sequence>
              </Fallback>
            </RetryUntilSuccessful>
            <Script code="survey_x := pickup_x; survey_y := pickup_y; survey_z := approach_z; survey_yaw := pickup_yaw"/>

            <SetBlackboard output_key="grasp_object_contains" value="{target_block_id}"/>

            <SubTree ID="SubTreePickAndPlaceBlock" _autoremap="true"/>

            <!-- The default response wait is tens of ms; under load the last block's call
                 took longer and aborted a finished wall. -->
            <SetBlockTaskStatus
              service_name="/world_model_node/set_block_task_status"
              server_timeout="5000"
              block_id="{target_block_id}"
              task_status="3"
              status_ok="{status_ok}"
              status_message="{status_message}"/>

            <!-- Re-observe the just-placed block against its FK-derived pose
               and correct it in the world model. The crane has known
               goal-pose error, so placement errors would otherwise compound
               uncorrected into the next block's plan. ForceSuccess: an
               occluded/failed re-measurement must not abort the assembly
               loop; the FK pose already written above remains the
               fallback, exactly as REFINE_GRASPED is treated pre-placement
               in operator_guided_single_block.xml. -->
            <ForceSuccess>
              <RunPoseEstimation
                service_name="/world_model_node/run_pose_estimation" server_timeout="10000"
                mode="REFINE_BLOCK" target_block_id="{target_block_id}"
                enable_debug="true" timeout_s="8.0" message="{placed_block_refine_message}"/>
            </ForceSuccess>

          </Sequence>
        </KeepRunningUntilFailure>

        <!-- Recovery: loop ended. Succeed iff that was because the plan is
             complete (plan_has_task=false); a real pick/place failure leaves
             plan_has_task=true and falls through as FAILURE. -->
        <PlanComplete name="plan_complete" plan_has_task="{plan_has_task}"/>
      </Fallback>

    </Sequence>
  </BehaviorTree>
  <!-- ////////// -->
</root>
