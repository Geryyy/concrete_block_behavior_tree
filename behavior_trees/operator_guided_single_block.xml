<?xml version="1.0"?>
<root main_tree_to_execute="OperatorGuidedSingleBlock" BTCPP_format="4">
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_execute_trajectory.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_move_above.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_descend_to.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_gripper.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_lift.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_pick_block.xml"/>
  <include path="install/concrete_block_behavior_tree/share/concrete_block_behavior_tree/behavior_trees/subtree_place_block.xml"/>
  <BehaviorTree ID="OperatorGuidedSingleBlock">
    <Sequence name="operator_guided_single_block">
      <SetBlackboard output_key="slow_down" value="1.0"/>
      <SetBlackboard output_key="s_log_8_x" value="0.0"/>
      <SetBlackboard output_key="s_log_8_y" value="0.0"/>
      <SetBlackboard output_key="s_log_8_z" value="nan"/>
      <SetBlackboard output_key="payload_mass" value="800.0"/>
      <SetBlackboard output_key="log_shape_text" value="radius_top: 0.30, radius_bottom: 0.30, length: 0.90"/>

      <WaitForOperatorCommand expected="acquire"/>
      <GetNextAssemblyTask
        service_name="/concrete_block_wall_plan_server/get_next_assembly_task"
        server_timeout="10000" wall_plan_name="" reset_plan="false"
        task_id="{task_id}" target_block_id="{target_block_id}" reference_block_id="{reference_block_id}"
        target_block_pose_coarse="{target_block_pose_coarse}"
        target_block_pose_precise="{target_block_pose_precise}"
        reference_block_pose_precise="{reference_block_pose_precise}"
        placement_approach_pose="{placement_approach_pose}"
        plan_has_task="{plan_has_task}" plan_message="{plan_message}"
        pickup_x="{pickup_x}" pickup_y="{pickup_y}" pickup_z="{pickup_z}" pickup_yaw="{pickup_yaw}"
        pickup_approach_z="{approach_z}" place_x="{place_x}" place_y="{place_y}"
        place_z="{place_z}" place_yaw="{place_yaw}"
        approach_x="{place_approach_x}" approach_y="{place_approach_y}" approach_z="{place_approach_z}"
        disturbed_approach_x="{initial_hover_x}" disturbed_approach_y="{initial_hover_y}"
        disturbed_approach_z="{initial_hover_z}" disturbed_approach_yaw="{initial_hover_yaw}"/>
      <SetBlackboard output_key="grasp_object_contains" value="{target_block_id}"/>
      <SetBlackboard output_key="planned_pickup_x" value="{pickup_x}"/>
      <SetBlackboard output_key="planned_pickup_y" value="{pickup_y}"/>
      <!-- Keep the planned endpoints immutable: the refinement loop derives
           its accumulated correction from these rather than reusing a prior
           corrected descend target. -->
      <SetBlackboard output_key="planned_place_x" value="{place_x}"/>
      <SetBlackboard output_key="planned_place_y" value="{place_y}"/>

      <!-- Pickup refinement happens before the gripper descends. Until the
           image-based REFINE_BLOCK path is replaced by the point-cloud
           detector, use the persistent scene-discovery pose as the trusted
           ground-block observation. A pickup correction still re-plans A2B
           from the measured crane state, recovering a missed hover endpoint. -->
      <WaitForOperatorCommand expected="pickup_hover"/>
      <SetBlackboard output_key="mv_x" value="{pickup_x}"/>
      <SetBlackboard output_key="mv_y" value="{pickup_y}"/>
      <SetBlackboard output_key="mv_z" value="{approach_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{pickup_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="false"/>
      <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
      <OperatorExitAsSuccess exit_requested="{pickup_exit_requested}">
        <KeepRunningUntilFailure name="pickup_refinement_loop">
          <Sequence>
            <WaitForOperatorCommand expected="pickup_measure" failure_commands="pick"
              exit_requested="{pickup_exit_requested}"/>
            <EvaluatePickupResidual
              service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
              block_id="{grasp_object_contains}"
              expected_pickup_pose="{target_block_pose_coarse}"
              planned_pickup_x="{planned_pickup_x}" planned_pickup_y="{planned_pickup_y}"
              translation_tolerance_m="0.04"
              within_tolerance="{pickup_within_tolerance}"
              translation_error_m="{pickup_translation_error_m}"
              residual_dx_m="{pickup_residual_dx_m}" residual_dy_m="{pickup_residual_dy_m}"
              corrected_pickup_x="{corrected_pickup_x}" corrected_pickup_y="{corrected_pickup_y}"
              message="{pickup_residual_message}"/>
            <WaitForOperatorCommand expected="pickup_correct" failure_commands="pick"
              exit_requested="{pickup_exit_requested}"/>
            <SetBlackboard output_key="pickup_x" value="{corrected_pickup_x}"/>
            <SetBlackboard output_key="pickup_y" value="{corrected_pickup_y}"/>
            <SetBlackboard output_key="mv_x" value="{corrected_pickup_x}"/>
            <SetBlackboard output_key="mv_y" value="{corrected_pickup_y}"/>
            <SetBlackboard output_key="mv_z" value="{approach_z}"/>
            <SetBlackboard output_key="mv_yaw" value="{pickup_yaw}"/>
            <SetBlackboard output_key="mv_carries" value="false"/>
            <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
          </Sequence>
        </KeepRunningUntilFailure>
      </OperatorExitAsSuccess>
      <SubTree ID="SubTreePickFromHover" _autoremap="true"/>

      <WaitForOperatorCommand expected="hover"/>
      <SetBlackboard output_key="mv_x" value="{initial_hover_x}"/>
      <SetBlackboard output_key="mv_y" value="{initial_hover_y}"/>
      <SetBlackboard output_key="mv_z" value="{initial_hover_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{initial_hover_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="true"/>
      <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>

      <!-- Closed-loop placement refinement.  Prefer a direct REFINE_GRASPED
           observation of the TASK_MOVE block, with its FK-tracked pose as the
           fallback; compare that pose with the planned block CoG at the
           pre-place hover.  "correct" re-plans from the measured crane state
           to that same hover pose, then returns here for another measurement.
           "place" is the explicit operator exit from the loop. -->
      <PlacementExitAsSuccess exit_requested="{placement_exit_requested}">
        <KeepRunningUntilFailure name="placement_refinement_loop">
          <Sequence>
            <!-- "place" returns FAILURE deliberately: it is the clean exit
               from KeepRunningUntilFailure into SubTreePlaceBlock below. -->
            <WaitForOperatorCommand expected="measure" failure_commands="place"
              exit_requested="{placement_exit_requested}"/>
            <!-- Prefer a direct observation of the carried block.  This can
               fail when the block is occluded; the FK TASK_MOVE pose below
               is deliberately retained as the deterministic fallback. -->
            <ForceSuccess>
              <RunPoseEstimation
                service_name="/world_model_node/run_pose_estimation" server_timeout="10000"
                mode="REFINE_GRASPED" target_block_id="{grasp_object_contains}"
                enable_debug="true" timeout_s="8.0" message="{grasped_measurement_message}"/>
            </ForceSuccess>
            <EvaluatePlacementResidual
              service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
              block_id="{grasp_object_contains}"
              expected_placement_pose="{reference_block_pose_precise}"
              expected_hover_pose="{placement_approach_pose}" compare_z="false"
              translation_tolerance_m="0.04" yaw_tolerance_rad="0.0873"
              current_hover_x="{mv_x}" current_hover_y="{mv_y}"
              planned_hover_x="{place_approach_x}" planned_hover_y="{place_approach_y}"
              planned_place_x="{planned_place_x}" planned_place_y="{planned_place_y}"
              max_correction_m="0.30"
              within_tolerance="{placement_within_tolerance}"
              translation_error_m="{placement_translation_error_m}"
              yaw_error_rad="{placement_yaw_error_rad}"
              residual_dx_m="{placement_residual_dx_m}"
              residual_dy_m="{placement_residual_dy_m}"
              corrected_hover_x="{corrected_hover_x}"
              corrected_hover_y="{corrected_hover_y}"
              corrected_place_x="{corrected_place_x}"
              corrected_place_y="{corrected_place_y}"
              message="{placement_residual_message}"/>
            <WaitForOperatorCommand expected="correct" failure_commands="place"
              exit_requested="{placement_exit_requested}"/>
            <!-- Correct by the measured residual rather than re-commanding the
                 planned hover.  The error is the block hanging off-centre in
                 the jaws, so the same gripper pose reproduces the same block
                 pose: only moving the gripper by the residual moves the block.
                 x/y come from the residual; z stays planned because the grip
                 descent owns the vertical coordinate. -->
            <Sequence name="correct_hover_by_residual">
              <SetBlackboard output_key="mv_x" value="{corrected_hover_x}"/>
              <SetBlackboard output_key="mv_y" value="{corrected_hover_y}"/>
              <SetBlackboard output_key="place_x" value="{corrected_place_x}"/>
              <SetBlackboard output_key="place_y" value="{corrected_place_y}"/>
              <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
              <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
              <SetBlackboard output_key="mv_carries" value="true"/>
              <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
            </Sequence>
          </Sequence>
        </KeepRunningUntilFailure>
      </PlacementExitAsSuccess>
      <!-- The operator workflow has already reached and optionally corrected
           the placement hover.  Do not re-plan a redundant A2B approach. -->
      <SubTree ID="SubTreePlaceFromHover" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>
</root>
