<?xml version="1.0"?>
<!-- A2B move to an RViz 2D goal pose, for the PZS100 stack.

     Same flow as epsilon_crane_behavior_tree/behavior_trees/move_empty.xml, without the two
     nodes that depend on log_state_estimator: the SwitchController that activates it, and
     CalcGripState (service calc_grip_state).

     pzs100_bringup.launch.py sets enable_log_state_estimator:="False", so that controller is
     never spawned and nothing serves calc_grip_state. CalcGripState waits for the service while
     the tree is being CONSTRUCTED, so its absence does not merely fail the node: it throws, and
     the panel reports the misleading "File exists but can't be loaded". Dropping it is what
     makes this tree loadable under PZS100. It only refreshed the gripper payload estimate and
     takes no part in the motion, so an empty gripper A2B move is unaffected.

     Use it to exercise the A2B controller (MPC or PID) from the RViz BehaviorTreePanel: load
     config/bt_panel_catalog.yaml, pick this entry, set a 2D goal pose in RViz, confirm on the
     remote. -->
<root main_tree_to_execute="Move Empty PZS100">
  <include
    path="install/epsilon_crane_behavior_tree/share/epsilon_crane_behavior_tree/behavior_trees/subtree_a2b_movement.xml"/>
  <BehaviorTree ID="Move Empty PZS100">
    <Sequence>
      <SetBlackboard output_key="slow_down" value="1.0"/>
      <Decorator ID="RetryUntilSuccessful" num_attempts="-1">
        <Decorator ID="WaitGoalPose" goal="{yN}" phi="{phi}" topic="goal_pose" z_offset="3.5">
          <Sequence>
            <OptimizeTargetAngle phi="{phi}"/>
            <CalcA2BMovement carriesLog="false"
              name="Calc approach target" phiToolN="{phi}"
              server_timeout="10000" service_name="a2b_movement" slowDown="{slow_down}" tEnd="0.0"
              trajectory="{trajectory}" yN="{yN}"/>
            <Condition ID="CheckUserApproval" topic="/gpio_controller/remote_ctrl_states"/>
          </Sequence>
        </Decorator>
      </Decorator>
      <SubTree ID="SubTreeA2BMovement" __shared_blackboard="true"/>
    </Sequence>
  </BehaviorTree>
</root>
