<root BTCPP_format="4">
  <!-- Collision-aware A2B move to an approach pose above a target.
       Caller sets on the (shared) blackboard before invoking:
         mv_x, mv_y, mv_z, mv_yaw  - approach pose (world)
         mv_carries                - "true"/"false": carrying a block?
       Produces: yN, phi (goal pose), trajectory. -->
  <BehaviorTree ID="SubTreeMoveAbove">
    <!-- Retry re-plans, it does not replay. The crane can stall short of the goal on the valve
         dead zone: the arm is close, the axis stops, and the controller aborts on goal time.
         Re-running CalcA2BMovement from wherever it actually stopped produces a short, slow
         correction move, which is the regime the crane positions accurately in. Replaying the
         same trajectory instead would command a jump from the new position, so the plan step
         has to be inside the retry.
         Each attempt still passes through CheckUserApproval, so the operator sees and confirms
         the correction rather than the crane moving again on its own. -->
    <Decorator ID="RetryUntilSuccessful" num_attempts="2" name="replan_on_missed_goal">
    <Sequence name="move_above">
      <!-- 0.02, not the JTC's 0.05: 0.05 rad of slew is 0.35 m at the block, and the descent
           was planned from there while the crane still arrived (sim, 2026-10-01). Without the
           MPC the goal aborts at it when the arm stalls short on the valve dead zone, which is
           what fires replan_on_missed_goal.
           MEASURED, NOT LOOSENED (issue 241). 21 arrivals over 4 e2e runs on these defaults:
           median residual 1.7 to 5.5 mrad per joint, p90 slew 0.0085, boom 0.0101, arm 0.0134,
           telescope 0.0034 m, rotator 0.0366. TCP sensitivity there (crane_model Jacobian,
           hanging): slew 6.1 to 6.9, boom 6.3 to 7.2, arm 4.1 to 5.1 m/rad, telescope 2.0 m/m
           (q5 mimics q4, so the travel is 2 q4), rotator 0.000 m/rad and pure tool yaw at
           1 rad/rad. So 0.02 rad is already 0.12 to 0.14 m at the block on slew and boom: the
           number is loose for every joint that moves the TCP, not tight, and the standing
           offset `crane_mpc.yaml` claims (0.06 rad) is not what arrives. The rotator alone has
           a larger own budget, the wall's 0.02 m clearance.horizontal over the block's 0.6 m
           depth: 0.067 rad of yaw against a square neighbour, 0.033 if the neighbour is yawed
           the same way. It stays at 0.02 because every reading above that came from a move
           crane_mpc stopped driving mid flight, where the residual is a frozen mid move error
           and not an arrival (issue 243 read this as kHorizonMaxAge 3.7 s lagging N Ts
           4.74 s; 247 made the bound follow the grid, so it no longer lags). -->
      <!-- Carrying only: the pickup approach needs no accuracy, the grasp tolerates it. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.02" _skipIf="mv_carries != 'true'"/>
      <SetBlackboard output_key="ex_goal_tolerance" value="0.05" _skipIf="mv_carries == 'true'"/>
      <!-- Sway: an empty hook need not wait out the swing to the verdict's 0.02 rad/s: ~5 s
           per move; the descent to the block lets it decay further. -->
      <SetBlackboard output_key="ex_sway_bound" value="0.0" _skipIf="mv_carries != 'true'"/>
      <SetBlackboard output_key="ex_sway_bound" value="0.1" _skipIf="mv_carries == 'true'"/>
      <!-- Dwell, for the same reason (issue 255): the 2.7 s is one period of the *carried*
           pendulum, and holding it on the pickup approach is ~2.4 s of pure pause in front
           of a crane that has already stopped. The grasp tolerates the swing the descent
           lets decay anyway, and 0.3 s still distinguishes a stop from one sample under
           the rate bound, which is all the gate is for here. -->
      <SetBlackboard output_key="ex_hold_s" value="0.3" _skipIf="mv_carries == 'true'"/>
      <SetBlackboard output_key="ex_hold_s" value="2.7" _skipIf="mv_carries != 'true'"/>
      <Script code="ex_publish_reference := false; ex_until_landed := false; ex_watch_landed := false; load_off := false"/>
      <Action ID="SetGoalPose" name="Set approach pose"
        yN_x="{mv_x}" yN_y="{mv_y}" yN_z="{mv_z}"
        phiN="{mv_yaw}"
        goal="{yN}" phi="{phi}"/>
      <Action ID="OptimizeTargetAngle" name="Prefer symmetric block yaw" phi="{phi}"/>
      <Action ID="CalcA2BMovement" name="Plan approach"
        carriesLog="{mv_carries}" logCarryingText="{log_shape_text}" logsScene="{logsScene}"
        m_log="{payload_mass}" phiToolN="{phi}"
        s_log_8_x="{s_log_8_x}" s_log_8_y="{s_log_8_y}" s_log_8_z="{s_log_8_z}"
        service_name="a2b_movement" server_timeout="30000"
        slowDown="{slow_down}" tEnd="0.0"
        trajectory="{trajectory}" yN="{yN}"/>
      <Action ID="CheckUserApproval" topic="/gpio_controller/remote_ctrl_states"/>
      <Action ID="PublishGripperState" name="Publish payload to MPC"
        carries="{mv_carries}" mass="{payload_mass}"
        log_shape_text="{log_shape_text}"
        s_log_8_x="{s_log_8_x}" s_log_8_y="{s_log_8_y}" s_log_8_z="{s_log_8_z}"/>
      <!-- Not SubTreeExecuteTrajectory: with the MPC driving, that held an action goal
           against the MPC's topic re-goals and ended the move without waiting for the
           load to stop swinging, so the descent set the block down mid-swing. -->
      <SubTree ID="SubTreeCbsA2BMovement" _autoremap="true"/>
    </Sequence>
    </Decorator>
  </BehaviorTree>
</root>
