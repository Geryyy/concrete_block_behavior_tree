<root>
  <!-- Collision-aware A2B move to an approach pose above a target.
       Caller sets on the (shared) blackboard before invoking:
         mv_x, mv_y, mv_z, mv_yaw  - approach pose (world)
         mv_carries                - "true"/"false": carrying a block?
       Produces: yN, phi (goal pose), trajectory. -->
  <BehaviorTree ID="SubTreeMoveAbove">
    <Sequence name="move_above">
      <Action ID="SetGoalPose" name="Set approach pose"
        yN.x="{mv_x}" yN.y="{mv_y}" yN.z="{mv_z}"
        phiN="{mv_yaw}"
        goal="{yN}" phi="{phi}"/>
      <Action ID="CalcA2BMovement" name="Plan approach"
        carriesLog="{mv_carries}" logCarryingText="{log_shape_text}" logsScene="{logsScene}"
        m_log="{payload_mass}" phiToolN="{phi}"
        s_log_8_x="{s_log_8_x}" s_log_8_y="{s_log_8_y}" s_log_8_z="{s_log_8_z}"
        service_name="a2b_movement" server_timeout="10000"
        slowDown="{slow_down}" tEnd="0.0"
        trajectory="{trajectory}" yN="{yN}"/>
      <Condition ID="CheckUserApproval" topic="/gpio_controller/remote_ctrl_states"/>
      <Action ID="PublishGripperState" name="Publish payload to MPC"
        carries="{mv_carries}" mass="{payload_mass}"
        log_shape_text="{log_shape_text}"
        s_log_8_x="{s_log_8_x}" s_log_8_y="{s_log_8_y}" s_log_8_z="{s_log_8_z}"/>
      <SubTree ID="SubTreeExecuteTrajectory" __shared_blackboard="true"/>
    </Sequence>
  </BehaviorTree>
</root>
