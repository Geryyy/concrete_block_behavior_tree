<root BTCPP_format="4">
  <!-- One full pick-and-place cycle for the block named by
       {grasp_object_contains}, using pickup_* and place_* set by the caller
       (e.g. GetNextAssemblyTask). Composed from SubTreePickBlock +
       SubTreePlaceBlock; see those files for the per-step breakdown. -->
  <BehaviorTree ID="SubTreePickAndPlaceBlock">
    <Sequence name="pick_and_place_block">
      <!-- Since 268 the plan server hands a task out again until its block is TASK_PLACED, so
           this is also the retry path. A block that comes back TASK_MOVE is one a cancelled run
           left mid-cycle, and the world model FK-tracks a TASK_MOVE pose off the TCP: picking it
           up again would descend on wherever the hook happened to stop. -->
      <GetBlockTaskStatus service_name="/world_model_node/get_coarse_blocks"
        server_timeout="5000" block_id="{grasp_object_contains}"
        task_status="{block_task_status}"/>
      <IfThenElse>
        <!-- Block.TASK_MOVE -->
        <ScriptCondition code="block_task_status == 2"/>
        <SubTree ID="SubTreeResumeCarry" _autoremap="true"/>
        <SubTree ID="SubTreePickBlock" _autoremap="true"/>
      </IfThenElse>
      <!-- A block gripped more than 3 deg crooked lands on an edge and slides 5-11 cm while
           the hook unloads, or its carry plan does not converge. -->
      <Fallback>
        <ScriptCondition code="grip_tilt &lt; 0.0524"/>
        <SubTree ID="SubTreeRegrip" _autoremap="true"/>
      </Fallback>
      <SubTree ID="SubTreePlaceBlock" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Take over the block the jaws already hold instead of picking it (issue 274). No gripper
       phase and no descent here: the jaws stay closed, nothing is aimed at the stale pickup
       pose, and the caller carries on to the place from wherever the cancel left the crane.
       Not held: the jaws are empty and the block is loose somewhere the plan does not know, so
       this fails rather than descend blind. GetBlockTaskStatus logs what the operator has to do
       (put it back, reset it to TASK_FREE); the failing node's name says it too. -->
  <BehaviorTree ID="SubTreeResumeCarry">
    <Sequence name="resume_carry">
      <!-- Transient_local Bool, 10 Hz: true for signal_duration_s after the jaws last squeezed
           over effort_threshold, refreshed by every sample that still does. In sim a held block
           keeps it true and this gate answered in 0.1 s. On the machine (4.0 s tail, threshold
           100000) it is NOT measured whether a passively held block stays over it - characterise
           that before trusting the resume there. 2 s only covers the publish period. -->
      <!-- The name is what the operator sees on the failure, so it says what the signal said,
           not what the hook holds: a block clamped under an expired signal fails here too. -->
      <Action ID="WaitForGraspSignal"
        name="No grasp signal for a TASK_MOVE block - check the hook before approaching"
        topic="/gripper/grasp_detected" timeout_ms="2000"/>
      <!-- Look at what is in the hand before anything is planned on it: the offset recovered
           below is the belief the cancelled run held, and an abort is what shifts a load. The
           grip_tilt the regrip gate reads comes off this. Without a detector it passes through
           and the recovered offset stands, as it does in the pick. -->
      <ForceSuccess>
        <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
          server_timeout="10000" mode="REFINE_GRASPED" target_block_id="{grasp_object_contains}"
          timeout_s="8.0"/>
      </ForceSuccess>
      <!-- The world model rewrites every TASK_MOVE pose as TCP * its stored grasp offset once
           per marker_refresh_period_s (0.5 s) and stamps it last_seen, which is the stamp this
           node looks the TCP up at. So this recovers the offset the cancelled run captured
           (vision-refined, if REFINE_GRASPED ran) without re-picking the block. -->
      <Action ID="CaptureBlockGraspOffset" name="Recover grasp offset"
        service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
        block_id="{grasp_object_contains}" gripper_frame="K8_tool_center_point"
        world_frame="world" grasp_offset="{grasp_offset}"
        s_log_8_x="{s_log_8_x}" s_log_8_y="{s_log_8_y}" s_log_8_z="{s_log_8_z}"/>
      <!-- Same 10 cm sanity clamp as the pick. -->
      <Script code="s_log_8_x := s_log_8_x &gt; 0.10 ? 0.10 : (s_log_8_x &lt; -0.10 ? -0.10 : s_log_8_x);
                    s_log_8_y := s_log_8_y &gt; 0.10 ? 0.10 : (s_log_8_y &lt; -0.10 ? -0.10 : s_log_8_y)"/>
      <!-- The MPC may have been restarted since, and the first move below is a carrying one. -->
      <Action ID="SetMpcPayload" name="Set MPC payload"
        service_name="/crane/mpc/set_payload"
        carries="true"
        mass="{payload_mass}"
        s_log_8_x="{s_log_8_x}"
        s_log_8_y="{s_log_8_y}"
        s_log_8_z="{s_log_8_z}"/>
      <!-- grip_tilt for the regrip gate in SubTreePickAndPlaceBlock. No lift first: SubTreeLift
           plans from {COG}, which a fresh run has not written, and the place's own A2B approach
           retries over a lift anyway. -->
      <!-- report="false": a grip-tilt read at the pickup, not an in-air pass over the slot. -->
      <Action ID="MeasureBlockFromGripper" grasp_offset="{grasp_offset}" window_s="2.7"
        tilt="{grip_tilt}" report="false"/>
    </Sequence>
  </BehaviorTree>

  <!-- Set the block down flat at regrip_* (K0_mounting_base, level ground, clear of the
       other blocks) and grip it again; the wall targets are kept across it.
       regrip_z, not pickup_z: the regrip spot is ground, the pickup need not be. Off the
       truck bed pickup_z is 1.32 m higher than the ground there, which set the block down
       in mid-air (SubTreeTouchdown's floor is place_z - 0.01) and then descended the re-pick
       onto nothing. -->
  <BehaviorTree ID="SubTreeRegrip">
    <Sequence name="regrip">
      <Script code="kept_x := place_x; kept_y := place_y; kept_z := place_z; kept_yaw := place_yaw; kept_ax := place_approach_x; kept_ay := place_approach_y"/>
      <Script code="place_x := regrip_x; place_y := regrip_y; place_z := regrip_z; place_yaw := pickup_yaw; place_approach_x := regrip_x; place_approach_y := regrip_y"/>
      <SubTree ID="SubTreeSetDown" _autoremap="true"/>
      <Script code="pickup_x := regrip_x; pickup_y := regrip_y; pickup_z := regrip_z"/>
      <SubTree ID="SubTreePickBlock" _autoremap="true"/>
      <Script code="place_x := kept_x; place_y := kept_y; place_z := kept_z; place_yaw := kept_yaw; place_approach_x := kept_ax; place_approach_y := kept_ay"/>
    </Sequence>
  </BehaviorTree>

  <!-- Set the carried block down at place_* unmeasured: a regrip needs it flat, not exact.
       The wall placement's in-air correction and angled entry cost ~50 s of it. -->
  <BehaviorTree ID="SubTreeSetDown">
    <Sequence name="set_down">
      <SetBlackboard output_key="mv_x" value="{place_x}"/>
      <SetBlackboard output_key="mv_y" value="{place_y}"/>
      <SetBlackboard output_key="mv_z" value="{place_approach_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="true"/>
      <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
      <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
      <SetBlackboard output_key="ex_sway_bound" value="0.0"/>
      <SetBlackboard output_key="dz_x" value="{place_x}"/>
      <SetBlackboard output_key="dz_y" value="{place_y}"/>
      <Script code="dz_z := place_z + 0.05; ex_until_landed := false"/>
      <SetBlackboard output_key="dz_yaw" value="{place_yaw}"/>
      <SetBlackboard output_key="dz_carries" value="true"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>
      <SubTree ID="SubTreeTouchdown" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>
</root>
