<root BTCPP_format="4">
  <!-- Pick the block identified by {grasp_object_contains} at pickup_{x,y,z,yaw}.
       Approach above -> open -> descend -> close -> verify grasp ->
       capture grasp offset / mark MOVING -> lift. Carries nothing on the way
       in; leaves the arm holding the block. -->
  <BehaviorTree ID="SubTreePickBlock">
    <Sequence name="pick_block">

      <!-- 0. A raised pickup (truck bed, block centre over K0 z -0.5) via the start pose's
           direction, folded in: stretched out over the wall, no corridor to the bed survived
           (the joint line ran into the container); from folded, every bed spot did. -->
      <!-- Disabled lab day 2026-11-04: also fired for a block stacked on a ground one
           (K0 z -0.06). Re-enable for truck pickups.
      <Sequence name="truck_via" _skipIf="pickup_z &lt; -0.5">
        <SetBlackboard output_key="mv_x" value="4.114"/>
        <SetBlackboard output_key="mv_y" value="4.111"/>
        <SetBlackboard output_key="mv_z" value="3.5"/>
        <SetBlackboard output_key="mv_yaw" value="{pickup_yaw}"/>
        <SetBlackboard output_key="mv_carries" value="false"/>
        <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>
      </Sequence>
      -->

      <!-- 1. Move above pickup -->
      <SetBlackboard output_key="mv_x" value="{pickup_x}"/>
      <SetBlackboard output_key="mv_y" value="{pickup_y}"/>
      <SetBlackboard output_key="mv_z" value="{approach_z}"/>
      <SetBlackboard output_key="mv_yaw" value="{pickup_yaw}"/>
      <SetBlackboard output_key="mv_carries" value="false"/>
      <SubTree ID="SubTreeMoveAbove" _autoremap="true"/>

      <!-- Look at the target from the hover before going down: a block first seen past a
           lifted one came back 15 cm off, and the jaws closed on nothing. Without a
           detection the plan's pose stands. -->
      <ForceSuccess>
        <Sequence>
          <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
            server_timeout="10000" mode="REFINE_BLOCK" target_block_id="{grasp_object_contains}"
            timeout_s="8.0"/>
          <EvaluatePickupResidual
            service_name="/world_model_node/get_coarse_blocks" server_timeout="5000"
            block_id="{grasp_object_contains}" expected_pickup_pose="{target_block_pose_coarse}"
            planned_pickup_x="{pickup_x}" planned_pickup_y="{pickup_y}"
            translation_tolerance_m="0.04"
            corrected_pickup_x="{corrected_pickup_x}" corrected_pickup_y="{corrected_pickup_y}"/>
          <Script code="pickup_x := corrected_pickup_x; pickup_y := corrected_pickup_y"/>
        </Sequence>
      </ForceSuccess>

      <SubTree ID="SubTreePickFromHover" _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Pick after the caller has already reached the selected pickup hover. -->
  <BehaviorTree ID="SubTreePickFromHover">
    <Sequence name="pick_from_hover">
      <!-- 1. Open gripper -->
      <SetBlackboard output_key="gr_phase" value="3"/>
      <SetBlackboard output_key="gr_carries" value="false"/>
      <SubTree ID="SubTreeGripper" _autoremap="true"/>

      <!-- 2. Descend to pickup -->
      <!-- Controller default: the grasp detector verifies this descent, not
           the goal tolerance, and the jaws close on whatever they reach. -->
      <SetBlackboard output_key="ex_goal_tolerance" value="0.05"/>
      <SetBlackboard output_key="dz_x" value="{pickup_x}"/>
      <SetBlackboard output_key="dz_y" value="{pickup_y}"/>
      <SetBlackboard output_key="dz_z" value="{pickup_z}"/>
      <SetBlackboard output_key="dz_yaw" value="{pickup_yaw}"/>
      <SetBlackboard output_key="dz_carries" value="false"/>
      <Script code="ex_until_landed := false; ex_watch_landed := false; load_off := false"/>
      <SubTree ID="SubTreeDescendTo" _autoremap="true"/>

      <!-- 3. Close gripper -->
      <SetBlackboard output_key="gr_phase" value="2"/>
      <SetBlackboard output_key="gr_carries" value="false"/>
      <SubTree ID="SubTreeGripper" _autoremap="true"/>

      <!-- 4. Verify grasp signal + register block as in-hand -->
      <Action ID="WaitForGraspSignal" name="Wait for grasp detector"
        topic="/gripper/grasp_detected"
        timeout_ms="8000"/>
      <Action ID="CaptureBlockGraspOffset" name="Capture grasp offset"
        service_name="/world_model_node/get_coarse_blocks"
        server_timeout="5000"
        block_id="{grasp_object_contains}"
        gripper_frame="K8_tool_center_point"
        world_frame="world"
        grasp_offset="{grasp_offset}"
        s_log_8_x="{s_log_8_x}"
        s_log_8_y="{s_log_8_y}"
        s_log_8_z="{s_log_8_z}"/>
      <Action ID="SetBlockTaskStatus" name="Mark block TASK_MOVE"
        service_name="/world_model_node/set_block_task_status"
        server_timeout="5000"
        block_id="{grasp_object_contains}"
        task_status="2"
        grasp_offset="{grasp_offset}"/>

      <!-- 5. Tell the MPC what it now carries. An unknown block is the one
           condition that leaves 174's measured mismatch envelope, and the lift
           below is the first carrying move. The COM's xy (planner and MPC alike) is clamped
           to 10 cm, a sanity bound on the measurement: both solve the sway equilibrium for the
           declared off-axis load, and a tighter clamp moves the hanging block off the model. -->
      <Script code="s_log_8_x := s_log_8_x &gt; 0.10 ? 0.10 : (s_log_8_x &lt; -0.10 ? -0.10 : s_log_8_x);
                    s_log_8_y := s_log_8_y &gt; 0.10 ? 0.10 : (s_log_8_y &lt; -0.10 ? -0.10 : s_log_8_y)"/>
      <Action ID="SetMpcPayload" name="Set MPC payload"
        service_name="/crane/mpc/set_payload"
        carries="true"
        mass="{payload_mass}"
        s_log_8_x="{s_log_8_x}"
        s_log_8_y="{s_log_8_y}"
        s_log_8_z="{s_log_8_z}"/>

      <!-- 6. Lift the grasped block -->
      <SetBlackboard output_key="lf_carries" value="true"/>
      <SubTree ID="SubTreeLift" _autoremap="true"/>

      <!-- 7. Look at the block in hand. The grasp offset above is FK against the world
           model's pose, which takes a block on uneven ground for flat: a block clamped 9 deg
           crooked hung under a gripper within 1.2 deg of vertical.
           Vision rewrites the carried block's pose; the offset is captured again from it,
           and grip_tilt is what the jaws really hold. Without a detector both pass through. -->
      <ForceSuccess>
        <RunPoseEstimation service_name="/world_model_node/run_pose_estimation"
          server_timeout="10000" mode="REFINE_GRASPED" target_block_id="{grasp_object_contains}"
          timeout_s="8.0" message="{grasp_refine_message}"/>
      </ForceSuccess>
      <!-- Only grasp_offset is taken: the payload stays what the MPC was given above. -->
      <Action ID="CaptureBlockGraspOffset" name="Capture grasp offset after vision"
        service_name="/world_model_node/get_coarse_blocks"
        server_timeout="5000"
        block_id="{grasp_object_contains}"
        gripper_frame="K8_tool_center_point"
        world_frame="world"
        grasp_offset="{grasp_offset}"
        s_log_8_x="{vision_s_log_8_x}"
        s_log_8_y="{vision_s_log_8_y}"
        s_log_8_z="{vision_s_log_8_z}"/>
      <Action ID="MeasureBlockFromGripper" grasp_offset="{grasp_offset}" window_s="2.7"
        tilt="{grip_tilt}"/>

    </Sequence>
  </BehaviorTree>
</root>
